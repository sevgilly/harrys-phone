function ini(n){var p=n.replace(/[^A-Za-z ]/g,'').split(' ').filter(Boolean);return ((p[0]||'?')[0]+(p.length>1?p[p.length-1][0]:'')).toUpperCase();}
function LD2(root,name,rows,list,view){var S={i:null};
 function render(){$('#'+root).html(S.i==null?list():view(rows[S.i]));}
 window[name]={mount:function(){S.i=null;render();$(document).off('click.hph.'+root).on('click.hph.'+root,'#'+root+' [data-l]',function(){var t=$(this);S.i=t.data('l')=='open'?t.data('k'):null;render();});}};}
function row(i,n,t,p,u,av){return '<div class="zrow" data-l="open" data-k="'+i+'">'+(u?'<i class="zdot"></i>':'')+(av?'<div class="zav">'+ini(n)+'</div>':'')+'<div class="zbd"><div class="z1"><b>'+n+'</b><span>'+t+'</span></div><div class="z2">'+p+'</div></div></div>';}


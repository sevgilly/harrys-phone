function V(){return State.variables;}
function bg(k){return "background-image:url('"+(IM[k]||(window.GALLERY&&GALLERY[k]))+"')";}
function tabs(){var t=[['★','lib','Library'],['❤','fy','For You'],['▦','alb','Albums'],['🔍','sr','Search']],s='<div class="ztb">';t.forEach(function(x){s+='<span data-p="tab" data-k="'+x[1]+'" class="'+(S.t==x[1]?'on':'')+'">'+x[0]+'<br>'+x[2]+'</span>';});return s+'</div>';}
function libV(){var s='<div class="zh"><span></span><span>Select</span></div><div class="zt">Library</div><div class="zl"><div class="pgd">';K.forEach(function(k){s+='<div class="pgt" data-p="ph" data-k="'+k+'" style="'+bg(k)+'"></div>';});return s+'</div><div class="pgc">'+K.length+' Photos</div></div>'+tabs();}
function albV(){var s='<div class="zh"><span>＋</span><span></span></div><div class="zt">Albums</div><div class="zl"><div class="zsec">My Albums</div><div class="alg"><div data-p="tab" data-k="lib"><div class="alc" style="'+bg('r1930')+'"></div>Recents<span class="zmu"> '+K.length+'</span></div><div><div class="alc" style="'+bg('r1928')+'"></div>Favorites<span class="zmu"> 4</span></div></div>';
if(!V().gHid)s+='<div class="zsec">Utilities</div><div class="zrow" data-p="hid"><span>🔒</span><div class="zbd"><b>Hidden</b></div><span class="zmu">12 ›</span></div>';
return s+'</div>'+tabs();}
function emptyV(n){return '<div class="zt" style="padding-top:20px">'+n+'</div><div class="zl"></div>'+tabs();}
function hidV(){return '<div class="sh-bg" data-p="cl"></div><div class="lg"><b>Are you sure?</b>'+(S.q==2?'<div class="pns">Not today</div><div class="lgb" data-p="cl">OK</div>':'<div class="mu">This album is hidden.</div><div class="pbt"><div class="lgb" data-p="yes">Yes</div><div class="lgb gy2" data-p="no">No</div></div>')+'</div>';}
function render(){var v=S.t=='alb'?albV():(S.t=='lib'?libV():emptyV(S.t=='fy'?'For You':'Search'));
if(S.v)v+='<div class="pgv"><div class="pgh" data-p="back">‹ Library</div><div class="pgi" style="'+bg(S.v)+'"></div></div>';
$('#phroot').html(v+(S.q?hidV():''));$('.screen').toggleClass('light',!S.v);}
function mount(){S.t='lib';S.v=null;S.q=0;render();
$(document).off('click.ph').on('click.ph','#phroot [data-p]',function(){var t=$(this),d=t.data('p'),k=t.data('k');
if(d=='tab'){S.t=k;}else if(d=='ph'){S.v=k;}else if(d=='back'){S.v=null;}
else if(d=='hid'){S.q=1;}else if(d=='yes'){S.q=2;}else if(d=='no'){V().gHid=1;S.q=0;}else if(d=='cl'){S.q=0;}
render();});}
return {mount:mount};})();

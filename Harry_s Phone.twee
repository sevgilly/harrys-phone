function F(k){var s=FS(k);if(s===1)return true;if(s===0||s===2)return false;return (k=='zee'||k=='nini'||k=='li');}
function RQ(k){return FS(k)===2;}
var HLO={lou:[{n:'All Around the World ✈️',p:["a1", "a2", "a3", "a4", "a5"],d:["Jul 3, 2025", "Jul 5, 2025", "Jul 9, 2025", "Jul 12, 2025", "Jul 15, 2025"]},{n:'Law ⚖️',p:["l1", "l2"],d:["Sep 9, 2026", "Oct 14, 2026"]},{n:'Nights 🥂',p:["n1", "n2", "n3", "n4"],d:["Aug 22, 2026", "Aug 23, 2026", "Sep 18, 2026", "Oct 3, 2026"]}]};
function curH(){var o=S.hv.o;if(S.hv.k==-2)return {p:SD[S.hv.u]};if(S.hv.k==-3){var A=arch();return {p:A.map(function(x){return x.k;}),d:A.map(function(x){return x.d;})};}if(o)return HLO[o][S.hv.k];return S.hv.k<0?STORY:ACC[S.acct].hl[S.hv.k];}
function arch(){var A=[];ACC.main.hl.forEach(function(h){if(typeof h=='string')return;h.p.forEach(function(k,i){A.push({k:k,d:h.d[i]});});});A.sort(function(a,b){return new Date(b.d)-new Date(a.d);});return A;}
function hlRow(k){var Lh=HLO[k];if(!Lh)return '';var s='<div class="hl">';Lh.forEach(function(h,i){s+='<div class="hi" data-a="hlo" data-i="'+i+'" data-k="'+k+'"><div class="hc" style="background-image:url(\''+IM[h.p[0]]+'\')"></div><span>'+h.n+'</span></div>';});return s+'</div>';}
function archV(){var A=arch(),s='<div class="dh"><span data-a="back">'+I('back',26)+'</span><b>Archive</b><span></span></div><div class="dt"><b>Stories archive</b></div><div class="xg">';A.forEach(function(x,i){s+='<div class="xt" data-a="av" data-i="'+i+'" style="background-image:url(\''+IM[x.k]+'\')"><div class="ard">'+x.d+'</div></div>';});return s+'</div>';}
function hvV(){var u=S.hv.u,k2=(S.hv.k==-2),ow=S.hv.o,h=curH(),n=h.p.length,it=h.p[S.hv.j],tx=(typeof it!='string'),dl=k2?((['2h','5h','9h'][S.hv.j]||'1d')+' ago'):(h.d?h.d[S.hv.j]:(S.hv.k==-1?'Nov 5, 2026':'')),who=k2?ava(u,32)+'<b>'+u+'</b>':(ow?av(AV[P[ow].a],32)+'<b>'+P[ow].u+'</b>':av(AV[S.acct],32)+'<b>'+ACC[S.acct].u+'</b>'),bgs=tx?'background:'+it[2]:'background-image:url(\''+IM[it]+'\')',s='<div class="hv"><div class="hvi" style="'+bgs+'">'+(tx?'<div class="hvt">'+it[1]+'</div>':'')+'</div><div class="hvg"></div><div class="hpb">',i;
for(i=0;i<n;i++)s+='<i><b class="'+(i<S.hv.j?'f':(i==S.hv.j?'a':''))+'"></b></i>';
return s+'</div><div class="hvh">'+who+'<span class="hvd">'+dl+'</span><span class="gr">'+I('dots',22,'#fff')+'<span data-a="hx">'+I('x',24,'#fff',2)+'</span></span></div>'+(S.hv.k==-1?'<div class="hcap">try new something. <span class="hmen">@zayn</span></div>':'')+'<div class="hvl" data-a="hp"></div><div class="hvr" data-a="hn"></div><div class="hvf">'+(S.hv.k==-1?'<div class="hvm" data-a="vw">👁 Seen by <b>hstyles</b> and 2,431 others</div>':'<div class="hvm">Send message</div>')+I('heart',28,'#fff')+I('dm',28,'#fff')+'</div></div>';}
function pgrid(p){var s='<div class="pg">';p.ps.forEach(function(x,i){s+='<div class="pc" data-a="hsp" data-k="'+p.k+'" data-i="'+i+'" style="background-image:url(\''+IM[x.k]+'\')"></div>';});return s+'</div>';}
function hpostV(){var p=P[S.pu],x=p.ps[S.i],id=p.k+':'+S.i;return '<div class="dh"><span data-a="hsb">'+I('back',26)+'</span><b>Posts</b><span class="gr"></span></div><div class="pr">'+av(AV[p.a],32)+'<b>'+p.u+'</b><span class="gr">'+I('dots',20)+'</span></div><div class="pi img" data-lk="'+id+'" style="background-image:url(\''+IM[x.k]+'\')"></div><div class="pa">'+hrt(id)+(p.cm?I('cmt',26):'')+I('dm',26)+'<span class="gr">'+I('bm',26)+'</span></div><div class="pt"><b>'+cnt(x.l,id)+' likes</b></div>'+(x.c?'<div class="pt"><b>'+p.u+'</b> '+x.c+'</div>':'')+(p.cm?'<div class="pt mu">View all '+x.m+' comments</div>':'<div class="pt mu">Comments on this post have been limited.</div>')+'<div class="pt mu sm">'+x.d+'</div>';}
function adv(){var h=curH();S.hv.j++;if(S.hv.j>=h.p.length){if(S.hv.k==-2)mark(S.hv.u);S.hv=null;}render();}
function stpV(){return '<div class="sh-bg" style="z-index:8"></div><div class="lg" style="z-index:9;top:70px"><b>Share to your story?</b><div class="stp" style="background-image:url(\''+IM.s1966+'\')"><span>try new something. <u>@zayn</u></span></div><div class="lgb" data-a="sshare">Share</div><div class="lgb gy2" data-a="sno">Don’t share</div></div>';}

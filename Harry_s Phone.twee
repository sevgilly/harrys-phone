else if(!v.zRes){T=setTimeout(function(){T=0;res();},1500);}}
function res(){var v=V(),y=v.zChoice=='yes';v.zRes=1;v.zayn=(v.zayn|0)+(y?5:-2);S.res=y?'g':'r';render();setTimeout(function(){if(S.res){done();}},3200);}
function done(){S.res=null;var v=V();if(v.zChoice=='yes'&&!(v.zStory|0)){v.zStory=1;Engine.play('Instagram');}else render();}
function mount(){clearTimeout(T);T=0;S.v='list';S.login=false;S.err=0;S.res=null;render();plan();

window.HM=(function(){
var T=[
 ['gate','Front Gate','Entrance','🔒','🔓','Locked','Unlocked',1],
 ['doors','House Doors','All floors','🚪','🚪','Locked','Unlocked',1],
 ['alarm','Security System','Whole house','🛡️','🛡️','Armed','Off',1],
 ['cams','Cameras','6 cameras','📹','📹','Recording','Paused',1],
 ['garage','Garage Door','Garage','🚘','🚘','Open','Closed',0],
 ['lights','Living Room','Lights','💡','💡','On','Off',1],
 ['pool','Pool Lights','Pool','🌊','🌊','On','Off',0],
 ['guest','Guest Room','Sound & scent seal','🛏️','🛏️','Sealed','Open',1],
 ['climate','Climate','Whole house','🌡️','🌡️','70°F','Off',1],
 ['music','Speakers','Whole house','🔊','🔊','Playing','Off',0]];
function st(){var v=State.variables;if(!v.hm){v.hm={};T.forEach(function(x){v.hm[x[0]]=x[7];});}return v.hm;}
function render(){var h=st(),on=0;T.forEach(function(x){if(h[x[0]])on++;});
 var s='<div class="hmh"><div class="hmt">Home</div><div class="hms">'+(h.alarm?'Security armed':'Security off')+' · '+on+' accessories on</div></div><div class="hmg">';
 T.forEach(function(x){var o=h[x[0]]?1:0;s+='<div class="hmc'+(o?' on':'')+'" data-hm="'+x[0]+'"><div class="hmi">'+(o?x[3]:x[4])+'</div><div><div class="hmn">'+x[1]+'</div><div class="hmr">'+x[2]+'</div><div class="hmst">'+(o?x[5]:x[6])+'</div></div></div>';});
 $('#hmroot').html(s+'</div>');}
function mount(){render();$(document).off('click.hph.hm').on('click.hph.hm','#hmroot [data-hm]',function(){var h=st(),k=$(this).data('hm');h[k]=h[k]?0:1;render();});}
return {mount:mount};})();

window.HNT=(function(){var S={v:'list',i:0};
var N=[
{t:'Business Statistics – Midterm',d:'Today',a:'November 6, 2026 at 8:30 AM',b:'Regression & hypothesis testing\n• Null vs alternative hypothesis\n• p-value < 0.05 → reject the null\n• R² is not causation\n\nPractice problems 4–12\n\nMidterm: Nov 25, Room C4'},
{t:'Training plan',d:'Yesterday',a:'November 5, 2026 at 9:15 PM',b:'Mon – gym + sprints\nTue – tactics\nWed – match prep\nThu – recovery\nFri – friendly\nSat – match day\n\nCaptain: run the warm-ups'},
{t:'Union to-do',d:'Tuesday',a:'November 3, 2026 at 6:40 PM',b:'☐ Book the hall for the winter social\n☐ Budget sheet for Niall\n☐ Order drinks (the cheap ones)\n☐ Fire-safety check\n☐ Send the weekly newsletter'},
{t:'Scholarship rules',d:'Monday',a:'November 2, 2026 at 11:02 PM',b:'• GPA ≥ 3.8\n• No disciplinary action\n• Clean record\n• Write the thank-you letter to the donor'}];
function pv(n){return n.b.split('\n')[1]||n.b.split('\n')[0];}
function listV(){var s='<div class="nh"><span class="ny">‹ Folders</span><span class="ny">•••</span></div><div class="nl"><div class="nt1">Notes</div><div class="nsb">🔍 Search</div>';
 ['Today','Previous 7 Days'].forEach(function(g,gi){s+='<div class="ns">'+g+'</div><div class="ng">';N.forEach(function(n,i){if((gi==0)==(i==0))s+='<div class="nr" data-n="open" data-k="'+i+'"><b>'+n.t+'</b><div><span class="nd">'+n.d+'</span> <span class="np">'+pv(n)+'</span></div></div>';});s+='</div>';});
 return s+'</div><div class="nft"><span></span><span>'+N.length+' Notes</span><span class="ny">✎</span></div>';}
function viewV(){var n=N[S.i];return '<div class="nh"><span class="ny" data-n="back">‹ Notes</span><span class="ny">•••</span></div><div class="nl"><div class="na">'+n.a+'</div><div class="nbd"><b>'+n.t+'</b>\n'+n.b+'</div></div>';}
function render(){$('#nroot').html(S.v=='view'?viewV():listV());}
function mount(){S.v='list';render();$(document).off('click.hph.nt').on('click.hph.nt','#nroot [data-n]',function(){var t=$(this),d=t.data('n');if(d=='open'){S.i=t.data('k');S.v='view';}else if(d=='back'){S.v='list';}render();});}
return {mount:mount};})();

/* --- Calendar --- */
window.HCL=(function(){var S={m:10,d:6},MN=['January','February','March','April','May','June','July','August','September','October','November','December'];
var CLS=[0,['Strategic Management','9:00 AM'],['Corporate Finance','11:00 AM'],['Business Statistics','10:00 AM'],['Marketing','1:00 PM'],['Accounting','9:00 AM']];
var EX={7:['Strategic Management Exam','9:00 AM'],9:['Corporate Finance Exam','9:00 AM'],11:['Business Statistics Exam','9:00 AM'],14:['Marketing Exam','1:00 PM'],16:['Accounting Final','9:00 AM']};
function ev(m,d){var l=[],w=new Date(2026,m,d).getDay(),cls=(m==10||(m==11&&d<=4));
 if(m==11&&EX[d])l.push({t:EX[d][0],h:EX[d][1],c:'#ff3b30'});
 if(m==11&&d==1)l.push({t:'Scholarship review',h:'10:00 AM',c:'#ff9500'});
 if(m==10&&d==25)l.push({t:'Business Statistics Midterm',h:'10:00 AM',c:'#ff3b30'});
 if(w==6&&m==10)l.push({t:'Match day',h:'3:00 PM',c:'#34c759'});
 if((w==1||w==3||w==5)&&cls)l.push({t:'Team training',h:'11:00 AM',c:'#34c759'});
 if(w==2&&cls)l.push({t:'Student Union meeting',h:'5:00 PM',c:'#af52de'});
 if(w>=1&&w<=5&&cls)l.push({t:CLS[w][0],h:CLS[w][1],c:'#0a84ff'});if(d==28&&(m==10||m==11))l.push({t:'Car payment due',h:'$289.00',c:'#ff9500'});
 return l;}
function render(){var m=S.m,fd=new Date(2026,m,1).getDay(),n=new Date(2026,m+1,0).getDate(),s='<div class="ch"><span data-c="prev" class="cr">‹</span><b>'+MN[m]+' 2026</b><span data-c="next" class="cr">›</span></div><div class="cw"><i>S</i><i>M</i><i>T</i><i>W</i><i>T</i><i>F</i><i>S</i></div><div class="cg">',i,d;
 for(i=0;i<fd;i++)s+='<div></div>';
 for(d=1;d<=n;d++){var e=ev(m,d),td=(m==10&&d==6);s+='<div class="cd" data-c="day" data-k="'+d+'"><span class="cn'+(td?' td':'')+(S.d==d?' sl':'')+'">'+d+'</span><u style="background:'+(e.length?e[0].c:'transparent')+'"></u></div>';}
 var l=ev(m,S.d),w=['Sunday','Monday','Tuesday','Wednesday','Thursday','Friday','Saturday'][new Date(2026,m,S.d).getDay()];
 s+='</div><div class="cl"><div class="cdh">'+w+', '+MN[m]+' '+S.d+'</div>';
 if(!l.length)s+='<div class="mu cen">No Events</div>';
 l.forEach(function(x){s+='<div class="cev"><span class="cb" style="background:'+x.c+'"></span><div><b>'+x.t+'</b><div class="mu">'+x.h+'</div></div></div>';});
 $('#croot').html(s+'</div>');}
function mount(){S.m=10;S.d=6;render();$(document).off('click.hph.cl').on('click.hph.cl','#croot [data-c]',function(){var t=$(this),d=t.data('c');
 if(d=='prev'&&S.m>10){S.m--;S.d=1;}else if(d=='next'&&S.m<11){S.m++;S.d=7;}else if(d=='day')S.d=t.data('k');render();});}
return {mount:mount};})();


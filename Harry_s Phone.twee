a.st.forEach(function(u){var sd=SD[u];s+='<div class="si"'+(sd?' data-a="sv" data-k="'+u+'"':(PK[u]?' data-a="pu" data-k="'+PK[u]+'"':''))+'><div class="ring'+(seen(u)?' seen':'')+'">'+ava(u,62)+'</div><span>'+u+'</span></div>';});
return s+'</div>'+(F('lou')?fpost('lou'):'')+fpost('zee')+fpost('nini')+(F('li')?fpost('li'):'');}

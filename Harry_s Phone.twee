.hms{opacity:.75;font-size:14px;margin-top:2px}
.hmg{flex:1;overflow-y:auto;padding:12px 16px 44px;display:grid;grid-template-columns:1fr 1fr;gap:12px;align-content:start;scrollbar-width:none}
.hmc{border-radius:20px;padding:14px;background:rgba(255,255,255,.16);display:flex;flex-direction:column;gap:14px;min-height:104px;cursor:pointer;user-select:none}
.hmc.on{background:rgba(255,255,255,.94);color:#111}
.hmi{font-size:28px;line-height:1}
.hmn{font-weight:600;font-size:15px}
.hmr{font-size:12px;opacity:.65;margin-top:1px}
.hmst{font-size:13px;font-weight:600;margin-top:4px}

/* ===== X profiles ===== */
.xwme{color:inherit;text-decoration:none}
.xwback{color:#fff;text-decoration:none;font-size:24px}
.xpb{height:110px;flex:none}
.xpi{display:flex;justify-content:space-between;align-items:flex-end;padding:0 16px;margin-top:-38px}
.xpav{width:80px;height:80px;border:4px solid #000;font-size:30px;background-size:cover;background-position:center}
.xpbtn{border:1px solid #536471;border-radius:20px;padding:6px 16px;font-weight:700;font-size:14px;color:#fff}
.xpm{padding:8px 16px 12px}
.xpn b{font-size:20px;color:#fff}
.xph{color:#71767b;font-size:14px}
.xpt{margin:8px 0;line-height:1.35}
.xpc{color:#71767b;font-size:14px}
.xpc b{color:#fff}
.xwr{color:#71767b;font-size:12px;padding:8px 16px 0 54px;font-weight:600}
.xwi{height:200px;border-radius:16px;background-size:cover;background-position:center;margin:8px 0 10px;border:1px solid #2f3336}

/* ===== Instagram threads ===== */
.thu{display:flex;align-items:center;gap:8px}
.thm{padding:10px 12px 90px;display:flex;flex-direction:column;gap:8px}
.thr{display:flex}.thr.o{justify-content:flex-end}.thr.i{justify-content:flex-start}
.thb{max-width:70%;padding:10px 14px;border-radius:22px;font-size:20px}
.thr.o .thb{background:#3797f0;color:#fff}.thr.i .thb{background:#efefef;color:#000}
.thc{width:190px;height:270px;border-radius:22px;position:relative;overflow:hidden;background-size:cover;background-position:center}
.thc.reel{background:linear-gradient(160deg,#2b2d42,#8d5a97);display:flex;align-items:center;justify-content:center}
.thp{font-size:44px;color:#fff;opacity:.9}
.thl{position:absolute;left:0;right:0;bottom:0;padding:10px 12px;background:linear-gradient(transparent,rgba(0,0,0,.7));color:#fff;font-size:13px;font-weight:600}
.sc2{display:block;font-size:24px;margin-bottom:6px}
.thi{position:absolute;left:12px;right:12px;bottom:68px;display:flex;justify-content:space-between;align-items:center;padding:10px 16px;border:1px solid #dbdbdb;border-radius:24px;color:#8e8e8e;background:#fff}

/* ===== readable lock-screen photo ===== */
.screen.wallset::before{content:'';position:absolute;inset:0;background:linear-gradient(180deg,rgba(0,0,0,.35) 0%,rgba(0,0,0,.05) 35%,rgba(0,0,0,.55) 100%);pointer-events:none;z-index:0}

/* ===== Messages compose bar ===== */
.zcomp{position:absolute;left:12px;right:12px;bottom:26px;display:flex;align-items:center;gap:10px}
.zin{flex:1;border:1px solid #d1d1d6;border-radius:20px;padding:8px 14px;color:#8e8e93;background:#fff}
.zpl{width:32px;height:32px;border-radius:50%;background:#e9e9ee;display:flex;align-items:center;justify-content:center;color:#8e8e93}
/* ===== Reels ===== */
#igroot .rlf{position:absolute;left:0;right:0;top:0;bottom:84px;overflow-y:scroll;scroll-snap-type:y mandatory;background:#000;scrollbar-width:none;z-index:2}
#igroot .rlf::-webkit-scrollbar{display:none}
.rlc{height:100%;min-height:100%;scroll-snap-align:start;scroll-snap-stop:always;position:relative;overflow:hidden;color:#fff}
.rls{position:absolute;inset:0;overflow:hidden}
.rlv{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
.rlg{position:absolute;left:0;right:0;bottom:0;height:42%;background:linear-gradient(transparent,rgba(0,0,0,.75));pointer-events:none}
.rla{position:absolute;right:10px;bottom:92px;display:flex;flex-direction:column;gap:16px;align-items:center}
.rlbtn{display:flex;flex-direction:column;align-items:center;font-size:12px;font-weight:600;cursor:pointer;user-select:none}
.rlbtn i{font-style:normal;font-size:28px;line-height:1}
.rlbtn.on i{color:#ff3040}
.rli{position:absolute;left:14px;right:78px;bottom:18px}
.rlu{display:flex;align-items:center;gap:8px}
.rlav{width:30px;height:30px;border-radius:50%;background:#3797f0;display:flex;align-items:center;justify-content:center;font-weight:700}
.rlfl{border:1px solid #fff;border-radius:8px;padding:2px 9px;font-size:12px;font-weight:600}
.rlt{margin-top:8px;font-size:14px;line-height:1.3}
.rlm{margin-top:6px;font-size:12px;opacity:.85}
.rlh{position:absolute;left:50%;top:42%;transform:translate(-50%,-50%);font-size:110px;color:#ff3040;animation:rx_rlpop .7s ease-out forwards;pointer-events:none}
@keyframes rx_rlpop{0%{transform:translate(-50%,-50%) scale(.3);opacity:0}30%{transform:translate(-50%,-50%) scale(1.15);opacity:1}100%{transform:translate(-50%,-80%) scale(1);opacity:0}}
.rs-cat,.rs-dog,.rs-alarm,.rs-pasta,.rs-peng,.rs-mon{display:flex;align-items:center;justify-content:center;font-size:clamp(100px,34vw,160px);text-shadow:0 10px 34px rgba(0,0,0,.22)}
.rs-cat{background:radial-gradient(circle at 50% 42%,#52677b,#172635 72%)}.rs-dog{background:radial-gradient(circle at 50% 42%,#3f8b69,#123b2c 72%)}.rs-alarm{background:radial-gradient(circle at 50% 42%,#9b78bf,#30204c 72%)}
.rs-pasta{background:linear-gradient(#5a2a0a,#c0641c)}.rs-peng{background:linear-gradient(#0b3a5a,#2a86b8)}.rs-mon{background:linear-gradient(#3a0a1a,#8a1c3a)}
.rx-cat-t{position:absolute;left:0;width:64%;top:56%;height:12px;background:#8d6e63;border-radius:0 6px 6px 0}
.rx-cat-g{position:absolute;left:56%;top:46%;font-size:54px;animation:rx_catg 4s ease-in infinite}
.rx-cat-c{position:absolute;left:8%;top:38%;font-size:96px;animation:rx_catc 4s ease-in-out infinite}
@keyframes rx_catc{0%,30%{transform:translateX(0)}42%{transform:translateX(120px)}55%,100%{transform:translateX(0)}}
@keyframes rx_catg{0%,40%{transform:translate(0,0) rotate(0)}52%{transform:translate(8px,-4px) rotate(18deg)}100%{transform:translate(40px,520px) rotate(200deg);opacity:0}}
.rx-dg{position:absolute;font-size:84px;animation:rx_dz 3s linear infinite}
.rx-dgb{position:absolute;left:46%;top:44%;font-size:40px;animation:rx_bn .6s ease-in-out infinite alternate}
@keyframes rx_dz{0%{left:8%;top:14%;transform:scaleX(-1)}25%{left:62%;top:14%;transform:scaleX(-1)}26%{transform:scaleX(1)}50%{left:62%;top:62%;transform:scaleX(1)}75%{left:8%;top:62%;transform:scaleX(1)}76%{transform:scaleX(-1)}100%{left:8%;top:14%;transform:scaleX(-1)}}
@keyframes rx_bn{from{transform:translateY(0)}to{transform:translateY(-26px)}}
.rx-al{position:absolute;left:50%;top:38%;margin-left:-55px;font-size:110px;animation:rx_shk .35s linear infinite}
@keyframes rx_shk{0%,100%{transform:rotate(-8deg)}50%{transform:rotate(8deg)}}
.rx-zz{position:absolute;font-size:40px;animation:rx_zup 2.4s ease-out infinite;opacity:0}
.rx-z1{left:60%;top:36%}.rx-z2{left:68%;top:30%;animation-delay:.8s}.rx-z3{left:26%;top:44%;animation-delay:1.5s}
@keyframes rx_zup{0%{transform:translateY(20px);opacity:0}30%{opacity:1}100%{transform:translateY(-90px);opacity:0}}
.rx-pa{position:absolute;left:50%;top:40%;margin-left:-55px;font-size:110px;animation:rx_bn2 1s ease-in-out infinite}
@keyframes rx_bn2{0%,100%{transform:translateY(0) rotate(-6deg)}50%{transform:translateY(-50px) rotate(6deg)}}
.rx-pc{position:absolute;font-size:44px;animation:rx_cf 1.6s ease-out infinite;opacity:0}
.rx-c1{left:22%;top:34%}.rx-c2{left:70%;top:30%;animation-delay:.5s}.rx-c3{left:46%;top:24%;animation-delay:1s}
@keyframes rx_cf{0%{transform:scale(.4) rotate(0);opacity:0}30%{opacity:1}100%{transform:translateY(-60px) scale(1.2) rotate(240deg);opacity:0}}
.rx-ice{position:absolute;left:0;right:0;top:58%;height:22%;background:linear-gradient(#cfeeff,#9ad4f2)}
.rx-pg{position:absolute;top:50%;font-size:84px;animation:rx_sl 3s ease-in-out infinite}
@keyframes rx_sl{0%{left:-18%;transform:rotate(-90deg)}50%{left:50%;transform:rotate(-90deg)}100%{left:112%;transform:rotate(-90deg)}}
.rx-fl{position:absolute;font-size:30px;animation:rx_snow 3s linear infinite}
.rx-f1{left:20%;top:6%}.rx-f2{left:55%;top:2%;animation-delay:1s}.rx-f3{left:80%;top:10%;animation-delay:2s}
@keyframes rx_snow{from{transform:translateY(0)}to{transform:translateY(300px)}}
.rx-mo{position:absolute;left:50%;top:40%;margin-left:-30px;font-size:60px;animation:rx_gr 3s ease-in infinite}
@keyframes rx_gr{0%{transform:scale(1)}100%{transform:scale(5);opacity:.85}}
.rx-mf{position:absolute;left:50%;top:66%;margin-left:-40px;font-size:80px;animation:rx_shk .25s linear infinite}

/* ===== Instagram stories & follow ===== */
.ring.seen{background:#c7c7cc !important}
.hvt{position:absolute;left:28px;right:28px;top:40%;font-size:28px;font-weight:700;text-align:center;color:#fff;line-height:1.25;text-shadow:0 2px 12px rgba(0,0,0,.45)}
.bt span[data-a="fol"]{cursor:pointer}

/* ===== story dates and archive ===== */
.hvd{font-size:12px;font-weight:400;opacity:.85;margin-left:8px}
.xg .xt{position:relative}
.ard{position:absolute;left:0;right:0;bottom:0;padding:14px 6px 4px;font-size:11px;font-weight:600;color:#fff;background:linear-gradient(transparent,rgba(0,0,0,.65))}


/* ===== iOS-style app icon refinement ===== */
.ic{width:62px;height:62px;border-radius:14px;overflow:hidden;box-shadow:0 1px 2px rgba(0,0,0,.18),inset 0 0 0 .35px rgba(0,0,0,.12)}
.ic::after{display:none}
.ic svg{width:35px;height:35px;filter:none}
.lb{font-size:12px;font-weight:400;letter-spacing:-.15px;text-shadow:0 1px 2px rgba(0,0,0,.28)}
/* Third-party brands */
.insta{background:radial-gradient(circle at 30% 108%,#ffdc80 0%,#fcaf45 17%,#f77737 38%,#e1306c 62%,#c13584 78%,#833ab4 100%)}
.insta svg{width:36px;height:36px}
.xx{background:#000}
.xx svg{width:34px;height:34px}
.wa{background:linear-gradient(145deg,#25d366,#00a884)}
.wa svg{width:37px;height:37px}
.mus{background:linear-gradient(145deg,#ff5a70,#fa233b)}
.tel,.msg,.ft{background:linear-gradient(145deg,#65e572,#19b94b)}
.saf{background:radial-gradient(circle at 50% 50%,#fff 0 48%,#e7edf4 75%,#c9d4e2 100%)}
.cam,.set{background:linear-gradient(145deg,#c7c7cc,#77777d)}
.pho{background:#fff}
.mail{background:linear-gradient(145deg,#65c8ff,#0878f9)}
.cal{background:#fff}
.cal .cd{font-size:9px;font-weight:700;letter-spacing:.5px}
.cal .cn{font-size:34px;font-weight:300}
.wea{background:linear-gradient(155deg,#54b5ff,#2675e8)}
.notes{background:linear-gradient(#ffd60a 0 29%,#fff 29% 100%)}
.rem,.hl,.fil{background:#fff}
.stk,.wal,.cmp{background:#000}
.ft{background:linear-gradient(145deg,#70e47a,#17b84b)}
.bk,.ev{background:linear-gradient(145deg,#ffbd4a,#ff8700)}
.st{background:linear-gradient(145deg,#50d8ff,#087cff)}
.calc{background:#29292d}
.sc{background:linear-gradient(145deg,#ff68a7,#814bff)}
/* Keep dock icons aligned and crisp like the iOS home screen. */
.dock{background:rgba(245,245,250,.25);border-radius:28px;box-shadow:inset 0 0 0 .6px rgba(255,255,255,.28)}
.dock .ic{width:62px;height:62px;border-radius:14px}
/* iPhone frame: restrained titanium edge and true black bezel. */
.device{background:linear-gradient(135deg,#b9b9bd 0%,#55565b 18%,#242529 48%,#77787d 78%,#c0c0c4 100%);box-shadow:0 0 0 1px #171719,0 32px 85px rgba(0,0,0,.62),inset 0 0 2px rgba(255,255,255,.65)}
.bezel{background:#050505}
.island{background:#000;box-shadow:0 0 0 1px rgba(255,255,255,.025)}
.home{height:5px;border-radius:5px}

/* ===== phone passages use the real visible height on mobile ===== */
body:not(.story){min-height:100vh;min-height:100dvh}
.device{will-change:transform}


/* ===== iOS 26-inspired lock screen + native app surfaces ===== */
.screen.lockwall,.screen.lockwall.hw{background-color:#101322;background-position:center;background-size:cover}
.screen.lockwall:before{content:"";position:absolute;inset:0;background:linear-gradient(180deg,rgba(8,10,22,.08),rgba(8,10,22,.08) 42%,rgba(4,6,14,.28));pointer-events:none;z-index:1}
.screen.lockwall .status{z-index:8;font-size:15px;font-weight:650;letter-spacing:-.25px}
.screen.lockwall .lw{top:68px;z-index:2}
.screen.lockwall .lw svg{width:17px;height:17px;opacity:.9}
.screen.lockwall .dt{font-size:20px;font-weight:550;letter-spacing:-.35px;text-shadow:0 1px 10px rgba(0,0,0,.22)}
.screen.lockwall .tm{font-size:104px;line-height:.94;font-weight:300;letter-spacing:-5.5px;margin-top:0;text-shadow:0 2px 24px rgba(0,0,0,.18);font-variant-numeric:tabular-nums}
.screen.lockwall .nl{top:418px;gap:9px;z-index:3}
.screen.lockwall .nt{min-height:64px;border-radius:22px;padding:11px 13px;background:rgba(245,246,250,.24);border:1px solid rgba(255,255,255,.2);backdrop-filter:blur(34px) saturate(1.75);-webkit-backdrop-filter:blur(34px) saturate(1.75);box-shadow:0 8px 24px rgba(0,0,0,.13),inset 0 1px 0 rgba(255,255,255,.2)}
.screen.lockwall .nh{font-size:14px;letter-spacing:-.1px}.screen.lockwall .nh span{font-size:12px;color:rgba(255,255,255,.78)}
.screen.lockwall .nm{font-size:13px;line-height:1.28;color:rgba(255,255,255,.96)}
.screen.lockwall .qb{width:52px;height:52px;bottom:48px;background:rgba(20,22,30,.34);border:1px solid rgba(255,255,255,.22);backdrop-filter:blur(22px);-webkit-backdrop-filter:blur(22px)}
.screen.lockwall .qb svg{width:21px;height:21px;fill:#fff}
.screen.lockwall .home{background:#fff;z-index:8}

/* App chrome: consistent safe area, status bar, typography and scroll surfaces */
#igroot,#waroot,#msroot,#ctroot,#strroot{font-family:-apple-system,BlinkMacSystemFont,"SF Pro Text","Helvetica Neue",Arial,sans-serif;letter-spacing:-.12px}
#igroot,#msroot,#ctroot,#strroot{background:#f2f2f7}
#igroot .igc{background:#fff;overscroll-behavior:contain}
#igroot .ih{height:52px;padding:2px 16px 0;border-bottom:.5px solid rgba(60,60,67,.14);background:rgba(255,255,255,.96)}
#igroot .wm{font-size:29px;letter-spacing:-1px}
#igroot .dh{height:50px;background:#fff}
#igroot .sr{background:#fff;padding-top:9px;padding-bottom:13px}
#igroot .si{font-size:11px;letter-spacing:0}
#igroot .igc img,#igroot .igc video{max-width:100%}
#igroot .igc .pr{padding:9px 14px}
#igroot .igc .av{box-shadow:0 0 0 .5px rgba(0,0,0,.08)}
#igroot .igc .tabbar{background:rgba(255,255,255,.97);backdrop-filter:blur(18px);-webkit-backdrop-filter:blur(18px)}

/* WhatsApp: current iOS-style chats list and conversation canvas */
#waroot{background:#fff}
#waroot .wh{min-height:48px;padding:7px 17px 5px;background:#fff}
#waroot .wt{font-size:34px;font-weight:750;letter-spacing:-1.1px;padding:0 17px 8px}
#waroot .wsb{margin:5px 16px 10px;border-radius:11px;background:#f1f1f5;color:#8e8e93;padding:9px 11px}
#waroot .wlr{min-height:68px;padding:9px 16px;gap:13px;border-bottom:.5px solid #e7e7eb}
#waroot .wlr b{font-size:16px;font-weight:600;letter-spacing:-.25px}
#waroot .wbody{background-color:#efeae2;background-image:radial-gradient(rgba(120,105,88,.08) .7px,transparent .7px);background-size:7px 7px;padding:12px 10px 14px;gap:7px}
#waroot .wmsg{border-radius:18px;padding:8px 11px 6px;font-size:15.5px;line-height:1.32;box-shadow:0 1px 1px rgba(0,0,0,.08)}
#waroot .wmsg.i{background:#fff;border-top-left-radius:6px}
#waroot .wmsg.o{background:#d9fdd3;border-top-right-radius:6px}
#waroot .wdate{border-radius:9px;background:rgba(255,255,255,.88);box-shadow:0 1px 3px rgba(0,0,0,.08);font-weight:600}
#waroot .wfoot{padding:9px 12px 34px;background:#f7f7f7;border-top:.5px solid #d8d8dc}
#waroot .wfi{border:0;border-radius:22px;min-height:39px;background:#fff;padding:10px 14px}

/* Messages, Phone and Contacts: native grouped-list materials */
#msroot,#ctroot{background:#f2f2f7}
#msroot .zh,#ctroot .zh{height:43px;padding:7px 17px;color:#007aff;font-size:16px}
#msroot .zt,#ctroot .zt{font-size:34px;font-weight:750;letter-spacing:-1.1px;padding:0 17px 8px}
#msroot .zs,#ctroot .zs{margin:4px 16px 10px;border-radius:11px;background:#e5e5ea;padding:9px 11px;font-size:16px}
#msroot .zl,#ctroot .zl{background:#fff}
#msroot .zrow,#ctroot .zrow{min-height:70px;padding:10px 16px 10px 19px;gap:12px;border-bottom:.5px solid #e5e5ea;background:#fff}
#msroot .zav,#ctroot .zav{width:46px;height:46px;border-radius:50%;font-size:18px}
#msroot .zbd b,#ctroot .zbd b{font-size:16px;font-weight:600;letter-spacing:-.2px}
#msroot .z2,#ctroot .z2{font-size:14px;line-height:1.25;color:#8e8e93}
#msroot .zd{margin:15px auto 10px;background:#e5e5ea;color:#68686d;border-radius:8px;padding:5px 10px;width:max-content}
#msroot .zbub{background:#e9e9eb;border-radius:19px 19px 19px 6px;padding:10px 13px;font-size:16px;line-height:1.35;box-shadow:0 1px 1px rgba(0,0,0,.04)}
#msroot .zcomp{bottom:25px;padding:8px 0 2px;background:rgba(242,242,247,.96);border-top:.5px solid #d9d9de}
#msroot .zin{border-radius:22px;border:1px solid #d1d1d6;min-height:38px;padding:8px 14px}
#msroot .zpl{border-radius:50%;width:31px;height:31px;background:#e5e5ea;color:#777}
#ctroot .ztb{background:rgba(249,249,251,.97);backdrop-filter:blur(18px);-webkit-backdrop-filter:blur(18px);border-top:.5px solid #d8d8dc}

/* Settings: grouped iOS Settings layout */
#strroot{background:#f2f2f7;padding-bottom:22px}
#strroot .stc{border-radius:14px;margin:7px 16px 16px;padding:14px;background:#fff;box-shadow:0 1px 0 rgba(0,0,0,.025)}
#strroot .stg{border-radius:13px;margin:0 16px 18px;background:#fff;box-shadow:0 1px 0 rgba(0,0,0,.025)}
#strroot .str{min-height:47px;padding:9px 13px;border-bottom:.5px solid #e7e7eb;font-size:15.5px}
#strroot .str:last-child{border-bottom:0}
#strroot .sti{width:29px;height:29px;border-radius:7px;font-size:15px}
#strroot .sft{padding-left:18px;padding-right:18px;color:#6d6d72;font-size:12px;letter-spacing:.25px}

/* Common iOS sheet and navigation details */
#igroot .sheet,#waroot .sheet{border-radius:24px 24px 0 0}
.screen.light .island{z-index:20}
.screen.light .status{z-index:19}
.screen.light .home{height:5px;width:135px;border-radius:5px;background:#000;bottom:8px}
@media(max-width:430px){.device{transform:scale(min(1, calc(100vw / 430)));transform-origin:center center}}



/* ===== Instagram UI refinement: current iOS-style inbox, chat and Reels ===== */
#igroot{font-family:-apple-system,BlinkMacSystemFont,"SF Pro Text",Arial,sans-serif;letter-spacing:-.12px}
#igroot .ih{height:52px;padding:0 15px;border-bottom:1px solid #f4f4f4}
#igroot .wm{font-size:27px;letter-spacing:-1.25px;font-weight:800;font-style:normal}
#igroot .ir{align-items:center;gap:19px}
#igroot .ir svg{width:25px;height:25px}
#igroot .tbb{height:66px;min-height:66px;padding:9px 0 0;border-top:1px solid #ededed;background:rgba(255,255,255,.98)}
#igroot .tbb span{height:34px;justify-content:center;flex:1}
#igroot .tbb svg{width:25px;height:25px}
#igroot .ig-dm-head{height:54px;display:flex;align-items:center;justify-content:space-between;padding:0 17px;background:#fff}
#igroot .ig-dm-user{display:flex;align-items:center;gap:5px;font-size:20px;font-weight:750;letter-spacing:-.5px}
#igroot .ig-dm-actions{display:flex;align-items:center;color:#111}
#igroot .ig-dm-search{height:38px;margin:5px 15px 12px;border-radius:10px;background:#efeff0;color:#8e8e93;display:flex;align-items:center;gap:8px;padding:0 11px;font-size:15px}
#igroot .ig-notes{display:flex;gap:17px;padding:0 15px 15px;overflow:hidden;border-bottom:1px solid #f1f1f1}
#igroot .ig-note{position:relative;display:flex;flex-direction:column;align-items:center;min-width:62px;font-size:12px;color:#222;gap:4px}
#igroot .ig-note-avatar{width:62px;height:62px;border-radius:50%;padding:2px;background:linear-gradient(45deg,#ffcc4d,#f04b72,#a33be0)}
#igroot .ig-note-avatar>.av{width:100%!important;height:100%!important;border:2px solid white}
#igroot .ig-note small{position:absolute;top:0;left:0;right:0;transform:translateY(-4px);background:#fff;border:1px solid #eee;border-radius:12px;padding:4px 5px;color:#777;font-size:9px;text-align:center;white-space:nowrap;overflow:hidden}
#igroot .ig-dm-title{display:flex;justify-content:space-between;align-items:center;padding:13px 17px 5px;font-size:16px}
#igroot .ig-dm-title b{font-weight:700}
#igroot .ig-dm-title .bl{font-size:13px;font-weight:600}
#igroot .ig-dm-row{height:76px;display:flex;align-items:center;gap:12px;padding:7px 16px;cursor:pointer;background:#fff}
#igroot .ig-dm-row:active{background:#f7f7f7}
#igroot .ig-dm-copy{flex:1;min-width:0;border-bottom:1px solid #f2f2f2;padding:0 0 10px}
#igroot .ig-dm-name{display:flex;align-items:center;justify-content:space-between;font-size:14px;margin-bottom:4px}
#igroot .ig-dm-name b{font-weight:600}
#igroot .ig-dm-name span{font-size:11px;color:#999}
#igroot .ig-dm-preview{font-size:12px;color:#8e8e93;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
#igroot .ig-unread{display:inline-block;width:7px;height:7px;background:#3797f0;border-radius:50%;margin-left:5px}
#igroot .ig-chat-head{height:58px;display:flex;align-items:center;gap:12px;padding:0 13px;border-bottom:1px solid #f1f1f1;background:#fff}
#igroot .ig-chat-head>span:first-child{display:flex;align-items:center}
#igroot .ig-chat-person{display:flex;align-items:center;gap:9px;flex:1;min-width:0}
#igroot .ig-chat-person>div:last-child{display:flex;flex-direction:column;gap:2px}
#igroot .ig-chat-person b{font-size:14px}
#igroot .ig-chat-person small{font-size:10px;color:#8e8e93}
#igroot .ig-chat-tools{display:flex;gap:17px;align-items:center}
#igroot .ig-chat-profile{display:flex;flex-direction:column;align-items:center;padding:24px 12px 17px;gap:5px;border-bottom:1px solid #f2f2f2}
#igroot .ig-chat-profile b{font-size:14px;margin-top:4px}
#igroot .ig-chat-profile span,#igroot .ig-chat-profile small{font-size:11px;color:#8e8e93}
#igroot .ig-chat-profile button{border:0;border-radius:7px;background:#efeff0;color:#111;font-size:11px;font-weight:650;padding:7px 13px;margin-top:5px}
#igroot .ig-chat-date{text-align:center;color:#999;font-size:9px;letter-spacing:1px;padding:13px 0 5px}
#igroot .thm{padding:8px 13px 12px;display:flex;flex-direction:column;gap:8px;min-height:160px}
#igroot .thr{display:flex;width:100%}
#igroot .thr.i{justify-content:flex-start}
#igroot .thr.o{justify-content:flex-end}
#igroot .thb{max-width:78%;border-radius:19px;padding:10px 14px;background:#efeff0;color:#111;font-size:13px;line-height:1.35}
#igroot .thr.o .thb{background:linear-gradient(135deg,#7b45d6,#b23bd1);color:#fff}
#igroot .thc{width:176px;height:214px;border-radius:14px;overflow:hidden;position:relative;background:#d9d9df}
#igroot .thc.reel{background:linear-gradient(145deg,#242424,#5d5d65)}
#igroot .thp{position:absolute;left:50%;top:45%;transform:translate(-50%,-50%);width:40px;height:40px;border-radius:50%;background:rgba(255,255,255,.9);color:#111;display:grid;place-items:center}
#igroot .thl{position:absolute;left:9px;right:9px;bottom:9px;color:#fff;font-size:10px;text-shadow:0 1px 3px #000}
#igroot .ig-chat-compose{height:46px;margin:5px 10px 11px;border:1px solid #e3e3e3;border-radius:24px;display:flex;align-items:center;gap:12px;padding:0 11px;color:#999;font-size:13px;background:#fff}
#igroot .ig-chat-compose>div{flex:1}
#igroot .ig-chat-camera{width:29px;height:29px;border-radius:50%;display:grid;place-items:center;background:linear-gradient(135deg,#7b45d6,#c13584)}
#igroot .rlf{bottom:66px}
#igroot .rlc{height:100%;min-height:100%;background:#111}
#igroot .rl-photo{background-position:center;background-size:cover;filter:saturate(1.04)}
#igroot .rlg{height:55%;background:linear-gradient(transparent 0%,rgba(0,0,0,.12) 35%,rgba(0,0,0,.8) 100%)}
#igroot .rla{bottom:105px;right:11px;gap:18px}
#igroot .rlbtn i{font-size:29px;text-shadow:0 1px 4px rgba(0,0,0,.4)}
#igroot .rli{bottom:23px;left:14px;right:72px}
#igroot .rlav{border:1.5px solid #fff;background:#555}
#igroot .rlfl{border-radius:7px;padding:4px 10px;margin-left:5px}
#igroot .rlt{font-size:13px;line-height:1.35;text-shadow:0 1px 3px #000}
#igroot .rlm{font-size:11px}

/* Mobile viewport fit: keep the full iPhone frame inside short/narrow screens. */
@media (max-width:600px){
  .device{transform:scale(var(--mobile-phone-scale,.88)) !important;transform-origin:center center !important;}
  #passages{min-height:100dvh;min-height:100vh;overflow:hidden;}
  body{min-height:100dvh;min-height:100vh;}
}


/* Instagram DM: realistic shared-Reel cards and friend-chat rhythm */
#igroot .thm{padding:10px 12px 90px;display:flex;flex-direction:column;gap:11px;overflow-y:auto;}
#igroot .thr{display:flex;align-items:flex-end;}
#igroot .thr.o{justify-content:flex-end;}
#igroot .thr.i{justify-content:flex-start;}
#igroot .thb{max-width:72%;padding:10px 14px;border-radius:20px;font-size:14px;line-height:1.35;}
#igroot .thr.o .thb{background:#3797f0;color:#fff;border-bottom-right-radius:6px;}
#igroot .thr.i .thb{background:#efefef;color:#111;border-bottom-left-radius:6px;}
#igroot .thc.reel{width:218px;height:auto;display:flex;flex-direction:column;align-items:stretch;justify-content:flex-start;overflow:hidden;border-radius:16px;background:#fff;border:1px solid #e7e7e7;box-shadow:0 1px 2px rgba(0,0,0,.06);}
#igroot .th-reel-art{height:196px;position:relative;display:flex;align-items:center;justify-content:center;overflow:hidden;background:linear-gradient(145deg,var(--reel-bg,#263b57),#10131c);}
#igroot .th-reel-art:before{content:"";position:absolute;width:190px;height:190px;border:1px solid rgba(255,255,255,.18);border-radius:50%;left:-58px;top:-68px;}
#igroot .th-reel-art:after{content:"";position:absolute;width:150px;height:150px;border:1px solid rgba(255,255,255,.13);border-radius:50%;right:-48px;bottom:-70px;}
#igroot .th-reel-emoji{font-size:62px;filter:drop-shadow(0 4px 8px rgba(0,0,0,.25));z-index:1;}
#igroot .thp{position:absolute;z-index:2;width:42px;height:42px;border-radius:50%;display:grid;place-items:center;background:rgba(0,0,0,.35);border:1px solid rgba(255,255,255,.75);font-size:19px;color:#fff;}
#igroot .th-reel-label{position:absolute;left:10px;top:10px;color:#fff;font-size:9px;font-weight:800;letter-spacing:1.4px;z-index:2;}
#igroot .th-reel-info{padding:9px 11px 10px;display:flex;flex-direction:column;gap:3px;color:#171717;}
#igroot .th-reel-info b{font-size:11px;color:#777;font-weight:650;}
#igroot .th-reel-info span{font-size:12px;line-height:1.3;font-weight:600;}
#igroot .th-reel-preview{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;opacity:.9}
#igroot .th-reel-art .thp{pointer-events:none}
#igroot .rl-missing{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:9px;padding:28px;text-align:center;color:#fff;background:linear-gradient(145deg,#26384b,#111);z-index:1}
#igroot .rl-missing b{font-size:18px}.rl-missing span{font-size:11px;opacity:.75;overflow-wrap:anywhere}
#igroot .rl-empty{color:#fff;padding:40px 22px;text-align:center}
.rl-modal{position:absolute;inset:0;z-index:999999;background:rgba(0,0,0,.94);display:flex;align-items:center;justify-content:center;padding:24px}
.rl-modal-video{max-width:min(92vw,520px);max-height:82vh;width:auto;height:auto;aspect-ratio:9/16;object-fit:contain;background:#000;border-radius:14px}
.rl-modal-close{position:absolute;top:18px;right:22px;width:42px;height:42px;border:0;border-radius:50%;background:rgba(255,255,255,.18);color:#fff;font-size:30px;line-height:1;cursor:pointer}
.rl-modal-caption{position:absolute;left:5vw;right:5vw;bottom:18px;color:#fff;display:flex;gap:8px;justify-content:center;flex-wrap:wrap;font-size:13px}

#igroot .th-reel-shared{font-size:10px;color:#8e8e93;padding:0 2px 2px;}
#igroot .ig-chat-profile small{font-size:11px;}

#igroot .dr{cursor:pointer;}
#igroot .dr-copy{min-width:0;flex:1;}
#igroot .dr-copy .mu{white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:250px;}
#igroot .ig-unread{width:7px;height:7px;border-radius:50%;background:#3797f0;margin-left:8px;flex:none;}


/* ===== V29: X app refresh ===== */
.xw{background:#000;color:#e7e9ea;font-family:Arial,Helvetica,sans-serif;padding-top:54px;letter-spacing:-.12px}
.xw-top{height:52px;flex:none;padding:0 16px;position:relative;justify-content:space-between;border-bottom:1px solid #202327}
.xw-top .xwme{display:flex;align-items:center;text-decoration:none}
.xw-avatar-mini{width:30px;height:30px;border-radius:50%;display:flex;align-items:center;justify-content:center;background:#14532d;color:#fff;font-size:13px;font-weight:700}
.x-brand{width:24px;height:24px;color:#e7e9ea;position:absolute;left:50%;top:14px;transform:translateX(-50%)}
.xw-top-action{width:29px;height:29px;border:1px solid #536471;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:22px;font-weight:300;color:#e7e9ea;line-height:1}
.xwtb{height:49px;flex:none;border-bottom:1px solid #2f3336;align-items:stretch}
.xwtb span{display:flex;align-items:center;justify-content:center;padding:0 10px;font-size:14px;font-weight:600;white-space:nowrap}
.xwtb .on{position:relative;color:#e7e9ea;border:0}
.xwtb .on:after{content:"";position:absolute;bottom:0;left:22%;right:22%;height:4px;border-radius:5px;background:#1d9bf0}
.xwf{overscroll-behavior:contain}
.xwp{gap:11px;padding:13px 14px 12px;border-bottom:1px solid #2f3336;align-items:flex-start}
.xwa{width:42px;height:42px;font-size:15px;overflow:hidden}
.xwb{font-size:14px;line-height:1.35}
.xwn{display:flex;align-items:center;gap:4px;min-width:0;line-height:19px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.xwn b{font-size:14px;font-weight:700;overflow:hidden;text-overflow:ellipsis}
.xwn span{font-size:13px;color:#71767b;overflow:hidden;text-overflow:ellipsis}
.xwx{font-size:14px;line-height:1.38;margin:2px 0 10px;white-space:pre-wrap;overflow-wrap:anywhere}
.xws{display:flex;justify-content:space-between;align-items:center;color:#71767b;font-size:11px;max-width:100%;gap:4px;margin-top:9px}
.xws span{display:inline-flex;align-items:center;gap:4px;white-space:nowrap}
.xws svg{width:15px;height:15px;fill:none;stroke:currentColor;stroke-width:1.55;stroke-linecap:round;stroke-linejoin:round;flex:none}
.xws span:nth-child(3){color:#71767b}
.xwnav{height:64px;flex:none;border-top:1px solid #2f3336;background:#000;display:flex;justify-content:space-around;align-items:center;padding:0 4px 8px;font-size:22px}
.xwnav span{width:20%;display:flex;align-items:center;justify-content:center;height:100%;color:#e7e9ea}
.xwnav svg{width:23px;height:23px;fill:none;stroke:currentColor;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round}
.xwfab{right:18px;bottom:82px;width:54px;height:54px;box-shadow:0 2px 8px #0008;background:#1d9bf0;font-size:27px}
.xw-profile-head{height:54px;flex:none;justify-content:flex-start;gap:26px;padding:0 16px;border-bottom:1px solid #2f3336}
.xw-profile-head>a{color:#e7e9ea;text-decoration:none;font-size:23px;width:20px}
.xw-profile-head>div{display:flex;flex-direction:column;line-height:18px}
.xw-profile-head b{font-size:17px}
.xw-profile-head small{font-size:11px;color:#71767b;font-weight:400}
.xw-profile-x{margin-left:auto;font-size:19px;font-weight:800}
.xpb{height:112px;background:linear-gradient(120deg,#173d31,#315f4b 55%,#10251e)!important}
.xpi{margin-top:-38px}
.xpav{width:82px;height:82px;border:4px solid #000}
.xpbtn{border:1px solid #536471;border-radius:22px;padding:7px 16px;font-size:13px;font-weight:700;background:#eff3f4;color:#0f1419}
.xpm{padding:9px 16px 13px}
.xpn b{font-size:20px}
.xph{font-size:13px;margin-top:1px}
.xpt{font-size:14px;margin:9px 0 10px}
.xpc{font-size:13px}
.xwr{padding-top:9px}
.xwi{border-radius:15px}

/* ===== X notifications and direct messages ===== */
.xwnav a{flex:1;display:flex;align-items:center;justify-content:center;color:#e7e9ea;text-decoration:none}
.xwnav a svg{width:24px;height:24px;fill:none;stroke:currentColor;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round}
.xwnav a.active{color:#1d9bf0}
.xwback{color:#e7e9ea;text-decoration:none;font-size:25px;min-width:28px}
.x-brand{font-size:22px;font-weight:800}
.xnitem{display:flex;gap:13px;padding:16px 14px;border-bottom:1px solid #2f3336;line-height:1.35}
.xnitem p{margin:5px 0 0;color:#e7e9ea}
.xnitem span{color:#71767b;font-size:12px}
.xnic{width:30px;height:30px;border-radius:50%;display:flex;align-items:center;justify-content:center;flex:none;font-size:20px;font-weight:700}
.xnic.blue{color:#1d9bf0}.xnic.gold{color:#e6b84b}.xnic.green{color:#00ba7c}.xnic.pink{color:#f91880}
.xmsg-search{margin:10px 14px;padding:11px 14px;background:#202327;border-radius:22px;color:#71767b;font-size:14px}
.xmsg-row{display:flex;gap:12px;align-items:center;padding:13px 14px;color:#e7e9ea;text-decoration:none;border-bottom:1px solid #2f3336}
.xmsg-av{width:48px;height:48px;border-radius:50%;display:flex;align-items:center;justify-content:center;color:white;font-weight:700;flex:none}
.xmsg-copy{min-width:0;flex:1}
.xmsg-copy>div{display:flex;justify-content:space-between;gap:8px}
.xmsg-copy span{color:#71767b;font-size:12px;white-space:nowrap}
.xmsg-copy p{margin:4px 0 0;color:#8b9298;font-size:13px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.xmsg-dot{width:8px;height:8px;border-radius:50%;background:#1d9bf0;flex:none}
.xw-chat .xwh{gap:12px;justify-content:flex-start}
.xchat-head{display:flex;align-items:center;gap:10px;flex:1}
.xchat-head small{display:block;color:#71767b;font-size:11px;font-weight:400;margin-top:2px}
.xchat-body{flex:1;overflow-y:auto;padding:16px 12px 18px;display:flex;flex-direction:column;gap:10px;scrollbar-width:none}
.xdmb{max-width:82%;padding:9px 12px;border-radius:17px;font-size:14px;line-height:1.35}
.xdmb p{margin:3px 0 4px}
.xdmb b{font-size:11px;color:#1d9bf0}
.xdmb small{display:block;text-align:right;color:#aab0b5;font-size:10px}
.xdmb.in{align-self:flex-start;background:#202327;color:#e7e9ea;border-bottom-left-radius:5px}
.xdmb.out{align-self:flex-end;background:#1d9bf0;color:white;border-bottom-right-radius:5px}
.xdmb.out small{color:#dcefff}
.xchat-compose{display:flex;gap:8px;align-items:center;padding:10px 12px;border-top:1px solid #2f3336}
.xchat-compose input{min-width:0;flex:1;border:1px solid #2f3336;border-radius:22px;background:#202327;color:#e7e9ea;padding:11px 14px;font:14px -apple-system,BlinkMacSystemFont,Arial;outline:none}
.xchat-compose button{width:38px;height:38px;border:0;border-radius:50%;background:#1d9bf0;color:white;font-size:18px}



/* ===== Harry phone v31: viewport fit + complete X interactions ===== */
.device{transform:scale(var(--mobile-phone-scale,1)) !important;transform-origin:center center !important;}
#passages{width:100%;}
.xw[data-harry-x="1"] .xwtb span{cursor:pointer;user-select:none;}
.xw[data-harry-x="1"] .xwtb span.on{color:#e7e9ea;font-weight:750;position:relative;}
.xw[data-harry-x="1"] .xwtb span.on:after{content:"";position:absolute;left:18%;right:18%;height:4px;bottom:-1px;border-radius:4px;background:#1d9bf0;}
.xw[data-harry-x="1"] .xws span{cursor:pointer;transition:color .15s ease;}
.xw[data-harry-x="1"] .xws span.x-liked{color:#f91880!important;}
.xw[data-harry-x="1"] .xws span.x-reposted{color:#00ba7c!important;}
.xw[data-harry-x="1"] .xw-top-action{display:grid;place-items:center;width:34px;height:34px;border-radius:50%;background:#1d9bf0;color:#fff;font-size:23px;cursor:pointer;}
.xw[data-harry-x="1"] .xw-compose-shade{position:absolute;inset:0;z-index:30;background:rgba(0,0,0,.64);display:flex;align-items:flex-start;justify-content:center;padding:72px 14px 18px;}
.xw[data-harry-x="1"] .xw-compose-card{width:100%;max-width:360px;background:#15202b;border:1px solid #38444d;border-radius:18px;padding:15px;box-shadow:0 18px 50px #0009;}
.xw[data-harry-x="1"] .xw-compose-head{display:flex;justify-content:space-between;align-items:center;margin-bottom:14px;color:#e7e9ea;font-weight:700;}
.xw[data-harry-x="1"] .xw-compose-close{border:0;background:transparent;color:#e7e9ea;font-size:24px;line-height:1;cursor:pointer;}
.xw[data-harry-x="1"] .xw-compose-card textarea{width:100%;height:150px;resize:none;border:0;outline:0;background:transparent;color:#e7e9ea;font:16px/1.45 -apple-system,BlinkMacSystemFont,Arial;}
.xw[data-harry-x="1"] .xw-compose-foot{display:flex;justify-content:flex-end;align-items:center;border-top:1px solid #38444d;padding-top:12px;}
.xw[data-harry-x="1"] .xw-compose-submit{border:0;border-radius:22px;background:#1d9bf0;color:white;font-weight:750;padding:9px 18px;cursor:pointer;}
.xw[data-harry-x="1"] .xw-empty{padding:35px 24px;text-align:center;color:#71767b;font-size:14px;line-height:1.5;}
.xw[data-harry-x="1"] .xw-new-post{border-bottom:1px solid #2f3336;padding:14px;display:flex;gap:11px;color:#e7e9ea;}
.xw[data-harry-x="1"] .xw-new-post .xwa{width:42px;height:42px;border-radius:50%;display:grid;place-items:center;flex:none;background:#14532d;font-weight:700;}
.xw[data-harry-x="1"] .xw-new-post .xwn{font-size:13px;margin-bottom:6px;}
.xw[data-harry-x="1"] .xw-new-post .xwn span{color:#71767b;font-weight:400;margin-left:5px;}
.xw[data-harry-x="1"] .xw-new-post .xwx{font-size:14px;line-height:1.4;white-space:pre-wrap;overflow-wrap:anywhere;}
.xw[data-harry-x="1"] .xw-new-post .xws{display:flex;justify-content:space-between;color:#71767b;font-size:11px;padding-top:12px;}
.xw[data-harry-x="1"] .xmsg-search input{width:100%;border:0;outline:0;background:transparent;color:#e7e9ea;font:14px -apple-system,BlinkMacSystemFont,Arial;}
.xmsg-row[hidden],.xwp[hidden],.xnitem[hidden]{display:none!important;}
@media(prefers-reduced-motion:reduce){.xw[data-harry-x="1"] .xws span{transition:none;}}

/* Harry secondary-page apps */
.happ{position:absolute;inset:54px 0 0;background:#f2f2f7;color:#17171a;display:flex;flex-direction:column;padding-bottom:30px;font-family:-apple-system,BlinkMacSystemFont,"SF Pro Text",Arial,sans-serif;}
.happ.dark{background:#090a0c;color:#f5f5f7;}
.happ-head{height:54px;flex:none;display:flex;align-items:center;gap:12px;padding:0 17px;border-bottom:1px solid rgba(0,0,0,.08);background:rgba(255,255,255,.92);}
.happ.dark .happ-head{background:#101114;border-color:#27282c;}
.happ-back{border:0;background:none;color:#087cff;font-size:27px;text-decoration:none;line-height:1;}
.happ-head b{font-size:18px;font-weight:750;}
.happ-scroll{flex:1;overflow-y:auto;padding:16px;scrollbar-width:none;}
.happ-scroll::-webkit-scrollbar{display:none;}
.happ-muted{color:#85858c;font-size:12px;}
.happ-card{background:#fff;border-radius:16px;padding:15px;margin:0 0 13px;box-shadow:0 1px 3px rgba(0,0,0,.06);}
.happ.dark .happ-card{background:#191a1f;box-shadow:none;}
.happ-row{display:flex;align-items:center;gap:12px;padding:13px 3px;border-bottom:1px solid #e9e9ed;}
.happ.dark .happ-row{border-color:#2a2b30;}
.happ-row:last-child{border-bottom:0;}
.happ-symbol{width:38px;height:38px;border-radius:11px;background:#e8f1ff;display:grid;place-items:center;font-size:20px;flex:none;}
.happ-row-main{min-width:0;flex:1;}
.happ-row-main b{display:block;font-size:14px;}
.happ-row-main small{display:block;color:#85858c;font-size:11px;margin-top:3px;}
.happ-value{font-size:14px;font-weight:650;text-align:right;}
.happ-hero{font-size:29px;font-weight:800;letter-spacing:-1px;margin:4px 0 8px;}
.happ-pill{display:inline-block;background:#e8f1ff;color:#087cff;padding:6px 10px;border-radius:20px;font-size:11px;font-weight:700;}
.hcalc-display{background:#fff;border-radius:16px;padding:20px 16px;text-align:right;font-size:42px;font-weight:300;min-height:94px;overflow:hidden;}
.hcalc-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:9px;margin-top:15px;}
.hcalc-key{height:66px;border:0;border-radius:50%;font-size:23px;background:#e5e5ea;color:#17171a;cursor:pointer;}
.hcalc-key.op{background:#ff9f0a;color:white;}
.hcalc-key.eq{background:#087cff;color:white;}
.hcalc-key.wide{grid-column:span 2;border-radius:36px;text-align:left;padding-left:26px;}
.hcompass{width:230px;height:230px;border-radius:50%;margin:28px auto;background:radial-gradient(circle,#fff 0 57%,#e4e7ed 58% 60%,#fff 61%);box-shadow:0 5px 24px #0001;position:relative;display:grid;place-items:center;}
.hcompass:before{content:"N";position:absolute;top:12px;font-weight:800;color:#ff453a;}
.hcompass:after{content:"S";position:absolute;bottom:12px;font-weight:800;color:#555;}
.hcompass-needle{width:8px;height:150px;background:linear-gradient(#ff453a 0 50%,#8b8b91 50%);clip-path:polygon(50% 0,100% 50%,50% 100%,0 50%);transform:rotate(28deg);}
.hshortcut{display:flex;align-items:center;gap:12px;padding:14px 4px;border-bottom:1px solid #e8e8ec;cursor:pointer;}
.hshortcut:last-child{border:0;}
.hshortcut i{font-style:normal;width:36px;height:36px;border-radius:10px;background:#087cff;color:#fff;display:grid;place-items:center;font-size:18px;}
.happ-toast{position:absolute;left:50%;bottom:50px;transform:translateX(-50%);background:#222;color:#fff;padding:10px 15px;border-radius:20px;font-size:12px;box-shadow:0 4px 18px #0004;z-index:25;white-space:nowrap;}

/* Home-screen page navigation: visible, tappable edge controls */
.pgn{display:flex;align-items:center;justify-content:center;color:rgba(255,255,255,.82)!important;text-decoration:none!important;font-size:34px;font-weight:300;text-shadow:0 1px 8px rgba(0,0,0,.45);width:30px!important;top:44%!important;bottom:auto!important;height:64px!important;border-radius:18px;background:rgba(0,0,0,.16);z-index:12}
.pgn.r{right:5px!important}.pgn.l{left:5px!important}
.pgn span{display:block;line-height:1}
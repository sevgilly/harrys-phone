 m.forEach(function(x){var c=(x[0]=='o')?'o':'i';if(x[1]=='reel'){var rr=(window.REELS||[]).filter(function(z){return z.id==x[6];})[0],src=rr?rr.src:'';s+='<div class="thr '+c+'"><div class="thc reel" data-reel="'+(x[6]||'')+'"><div class="th-reel-art" style="--reel-bg:'+x[5]+'">'+(src?'<video class="th-reel-preview" src="'+src+'" muted playsinline preload="metadata"></video>':'')+'<span class="th-reel-label">REELS</span><span class="th-reel-emoji">'+x[4]+'</span><div class="thp">▶</div></div><div class="th-reel-info"><b>'+x[2]+'</b><span>'+x[3]+'</span></div></div></div>';}else if(x[1]=='story'){s+='<div class="thr '+c+'"><div class="thc story" style="background-image:url(\''+IM[x[3]]+'\')"><div class="thl">'+x[2]+'</div></div></div>';}else{s+='<div class="thr '+c+'"><div class="thb">'+x[2]+'</div></div>';}});
 return s+'</div><div class="ig-chat-compose"><span class="ig-chat-camera">'+I('plus',20,'#fff',2)+'</span><div>Message…</div>'+I('heart',23,'#111')+'☺︎</div>';}

if(d=='open'){S.v='chat';S.c=k;byId(k).u=0;if(k=='zayn'){if(!(V().zStage|0))V().zStage=1;plan();}}
else if(d=='back'){S.v=(S.v=='chat'&&byId(S.c).lk)?'locked':'list';}
else if(d=='tab'){S.v=k=='s'?'set':'list';}
else if(d=='lock'){if(S.auth)S.v='locked';else{S.login=true;S.err=0;}}
else if(d=='login'){if(String($('#wpw').val()).trim()==WPW){S.auth=true;S.login=false;S.err=0;S.v='locked';}else{S.err=1;}}
else if(d=='lc'){S.login=false;S.err=0;}
else if(d=='pick'){V().zChoice=k;V().zStage=4;plan();}
else if(d=='res'){done();}
render();});

/* ===== Hikaye <-> telefon baglantisi ===== */
window.HC=(function(){
var MSG=[['o','i can’t believe you declined my call.'],['i','sorry honey, studying. thought you were at the bar. slow night?'],['o','you could say that. waiting for an uber, i’ll be at the house in a bit.'],['i','i’m not at the house, Haz.'],['o','where are you?'],['i','at louis’. we’re studying.'],['o','oh. didn’t expect that to happen so soon. when are you coming back?'],['i','almost done here. wanna come pick me up?'],['o','send the address.']];
var T=0,TOK=0;
function bub(m){return '<div class="hcb '+(m[0]=='o'?'hco':'hci')+'">'+m[1]+'</div>';}
function mount(){
 var v=State.variables,seen=((v.hcSeen|0)===1)||window.HC_SEEN===1,tok=++TOK;clearTimeout(T);
 $('#hcroot').html('<div class="hch"><span class="hcbk">‹</span><div class="hcav">Z</div><b>Zee 🧑🏽‍🎨</b></div><div class="hcm" id="hcm"></div><div class="hcf"><div class="hcin">iMessage</div></div>');
 var box=$('#hcm');
 function sc(){var e=box[0];if(e)e.scrollTop=e.scrollHeight;}
 if(seen){box.html(MSG.map(bub).join(''));sc();return;}
 v.hcSeen=1;window.HC_SEEN=1;
 var i=0;
 function step(){
  if(tok!==TOK||!$('#hcm').length||i>=MSG.length)return;
  var m=MSG[i];
  if(m[0]=='i'){
   box.append('<div class="hcb hci hct">•••</div>');sc();
   T=setTimeout(function(){if(tok!==TOK)return;box.find('.hct').remove();box.append(bub(m));i++;sc();T=setTimeout(step,900);},1100);
  }else{box.append(bub(m));i++;sc();T=setTimeout(step,900);}
 }
 step();
}
return {mount:mount,stop:function(){TOK++;clearTimeout(T);}};})();


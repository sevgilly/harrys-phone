function loginV(){return '<div class="sh-bg" data-n="lc"></div><div class="lg"><div style="font-size:40px">🔒</div><b>This note is locked</b><div class="mu">Enter your password to view this note</div><input id="npw" type="password" placeholder="Hint: his scent" autocomplete="off">'+(S.err?'<div class="er">The password you entered is incorrect.</div>':'')+'<div class="lgb" data-n="login">View Note</div><div class="mu lc" data-n="lc">Cancel</div></div>';}
function render(){$('#nroot').html((S.v=='view'?viewV():listV())+(S.login?loginV():''));}
function mount(){S.v='list';S.login=false;S.err=0;render();
$(document).off('click.nt').on('click.nt','#nroot [data-n]',function(){var t=$(this),d=t.data('n'),k=t.data('k');
if(d=='open'){S.i=k;if(N[k].lock&&!S.ok[k]){S.login=true;S.err=0;}else S.v='view';}
else if(d=='back'){S.v='list';}
else if(d=='lc'){S.login=false;S.err=0;}
else if(d=='login'){if(NPW.indexOf(String($('#npw').val()).trim().toLowerCase())>-1){S.ok[S.i]=1;S.login=false;S.err=0;S.v='view';}else S.err=1;}
render();});
$(document).off('keydown.nt').on('keydown.nt','#npw',function(e){if(e.which==13){$('#nroot [data-n="login"]').trigger('click');}});}
return {mount:mount};})();
window.CL=(function(){
var S={m:10,d:6},MN=['January','February','March','April','May','June','July','August','September','October','November','December'];
var CLS=[0,['Contract Law','9:00 AM'],['Constitutional Law','10:30 AM'],['Criminal Law','9:00 AM'],['Torts','1:00 PM'],['Property Law','11:00 AM']];
var EX={7:['Contract Law Exam','9:00 AM'],9:['Constitutional Law Exam','9:00 AM'],11:['Criminal Law Exam','9:00 AM'],14:['Torts Exam','1:00 PM'],16:['Property Law Exam','9:00 AM'],18:['Legal Writing Final','10:00 AM']};
function ev(m,d){var l=[],w=new Date(2026,m,d).getDay();
if(m==11&&EX[d])l.push({t:EX[d][0],h:EX[d][1],c:'#ff3b30'});
if(m==10&&d==12)l.push({t:'Doctor appointment',h:'10:30 AM',c:'#34c759'});
if(w>=1&&w<=5&&(m==10||(m==11&&d<=4)))l.push({t:CLS[w][0],h:CLS[w][1],c:'#0a84ff'});
return l;}
function render(){var m=S.m,fd=new Date(2026,m,1).getDay(),n=new Date(2026,m+1,0).getDate(),s='<div class="ch"><span data-c="prev" class="cr">‹</span><b>'+MN[m]+' 2026</b><span data-c="next" class="cr">›</span></div><div class="cw"><i>S</i><i>M</i><i>T</i><i>W</i><i>T</i><i>F</i><i>S</i></div><div class="cg">',i,d;
for(i=0;i<fd;i++)s+='<div></div>';
for(d=1;d<=n;d++){var e=ev(m,d),td=(m==10&&d==6);s+='<div class="cd" data-c="day" data-k="'+d+'"><span class="cn'+(td?' td':'')+(S.d==d?' sl':'')+'">'+d+'</span><u style="background:'+(e.length?e[0].c:'transparent')+'"></u></div>';}
var l=ev(m,S.d),w=['Sunday','Monday','Tuesday','Wednesday','Thursday','Friday','Saturday'][new Date(2026,m,S.d).getDay()];
s+='</div><div class="cl"><div class="cdh">'+w+', '+MN[m]+' '+S.d+'</div>';
if(!l.length)s+='<div class="mu cen">No Events</div>';
l.forEach(function(x){s+='<div class="cev"><span class="cb" style="background:'+x.c+'"></span><div><b>'+x.t+'</b><div class="mu">'+x.h+'</div></div></div>';});
$('#croot').html(s+'</div>');}
function mount(){S.m=10;S.d=6;render();
$(document).off('click.cl').on('click.cl','#croot [data-c]',function(){var t=$(this),d=t.data('c');
if(d=='prev'&&S.m>10){S.m--;S.d=1;}else if(d=='next'&&S.m<11){S.m++;S.d=7;}else if(d=='day')S.d=t.data('k');
render();});}
return {mount:mount};})();

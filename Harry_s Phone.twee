var s='<div class="dh"><b class="un" data-a="sheet">'+a.u+I('chev',16)+'</b><span class="gr" style="color:#000">'+I('plus',26)+'<span data-a="arch">'+I('menu',26)+'</span></span></div><div class="pro">'+av(AV.hs,86)+stats(a.po,a.fo,(S.acct=='main'&&!isNaN(+a.fg))?(+a.fg+(State.variables.igdH|0)):a.fg)+'</div><div class="bi"><b>'+a.n+'</b><div>'+a.bio+'</div></div><div class="bt"><span>Edit profile</span><span>Share profile</span></div><div class="hl">';
a.hl.forEach(function(h,i){if(typeof h=='string'){s+='<div class="hi"><div class="hc"></div><span>'+h+'</span></div>';}else{s+='<div class="hi" data-a="hl" data-i="'+i+'"><div class="hc" style="background-image:url(\''+IM[h.p[0]]+'\')"></div><span>'+h.n+'</span></div>';}});

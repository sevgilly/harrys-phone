(function(){
var PG={'Home Screen':['Home Screen','Home Screen 2'],'Home Screen 2':['Home Screen','Home Screen 2'],'H Home Screen':['H Home Screen','H Home Screen 2'],'H Home Screen 2':['H Home Screen','H Home Screen 2']};
var x0=null,y0=null;
function pt(e){var o=e.originalEvent||e,p=(o.changedTouches&&o.changedTouches[0])||(o.touches&&o.touches[0])||o;return p;}
$(document).on('touchstart mousedown','.screen',function(e){var p=pt(e);x0=p.clientX;y0=p.clientY;});
$(document).on('touchend mouseup','.screen',function(e){
 if(x0===null)return;var p=pt(e),dx=p.clientX-x0,dy=p.clientY-y0;x0=null;
 var n=State.passage,m=PG[n];if(!m||Math.abs(dx)<60||Math.abs(dx)<Math.abs(dy)*1.5)return;
 var to=dx<0?m[1]:m[0];if(to!==n)Engine.play(to);
});
})();


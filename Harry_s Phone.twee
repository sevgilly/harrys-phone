 2.8 8 7Z"/></svg> 96</span><span><svg viewBox="0 0 24 24"><path d="m17 3 4 4-4 4M3 7h18M7 21l-4-4 4-4M21 17H3"/></svg> 5.8K</span><span><svg viewBox="0 0 24 24"><path d="M20.8 8.8c0 5-8.8 11-8.8 11s-8.8-6-8.8-11A4.8 4.8 0 0 1 12 6.2a4.8 4.8 0 0 1 8.8 2.6Z"/></svg> 18K</span><span><svg viewBox="0 0 24 24"><path d="M3 20V4M3 20h18M7 16v-4m5 4V7m5 9v-6"/></svg> 402K</span><span>⬆</span></div></div></div><div class="xwr">🔁 Louis reposted</div><div class="xwp"><div class="xwa" style="background:#2b5a8a">H</div><div class="xwb"><div class="xwn"><b>Heat Leave Coalition</b><span>@heatleave · 3h</span></div><div class="xwx">Universities must offer private heat accommodations without academic penalty. Know the policy and ask for it in writing.</div><div class="xws"><span><svg viewBox="0 0 24 24"><path d="M20 11.5a7.5 7.5 0 0 1-8 7.5 8.8 8.8 0 0 1-3.6-.8L4 20l1.2-3.5A7.2 7.2 0 0 1 4 12c0-4.2 3.6-7.5 8-7.5s8 2.8 8 7Z"/></svg> 41</span><span><svg viewBox="0 0 24 24"><path d="m17 3 4 4-4 4M3 7h18M7 21l-4-4 4-4M21 17H3"/></svg> 2.9K</span><span><svg viewBox="0 0 24 24"><path d="M20.8 8.8c0 5-8.8 11-8.8 11s-8.8-6-8.8-11A4.8 4.8 0 0 1 12 6.2a4.8 4.8 0 0 1 8.8 2.6Z"/></svg> 9.2K</span><span><svg viewBox="0 0 24 24"><path d="M3 20V4M3 20h18M7 16v-4m5 4V7m5 9v-6"/></svg> 188K</span><span>⬆</span></div></div></div><div class="xwr">🔁 Louis reposted</div><div class="xwp"><div class="xwa" style="background:#2f7d5a">O</div><div class="xwb"><div class="xwn"><b>Omega Legal Clinic</b><span>@omegalegalclinic · 8h</span></div><div class="xwx">Free clinic for omegas facing discrimination over prescribed medication at work or school. Walk-ins welcome, Thursdays 4–7 PM.</div><div class="xws"><span><svg viewBox="0 0 24 24"><path d="M20 11.5a7.5 7.5 0 0 1-8 7.5 8.8 8.8 0 0 1-3.6-.8L4 20l1.2-3.5A7.2 7.2 0 0 1 4 12c0-4.2 3.6-7.5 8-7.5s8 2.8 8 7Z"/></svg> 23</span><span><svg viewBox="0 0 24 24"><path d="m17 3 4 4-4 4M3 7h18M7 21l-4-4 4-4M21 17H3"/></svg> 1.7K</span><span><svg viewBox="0 0 24 24"><path d="M20.8 8.8c0 5-8.8 11-8.8 11s-8.8-6-8.8-11A4.8 4.8 0 0 1 12 6.2a4.8 4.8 0 0 1 8.8 2.6Z"/></svg> 4.6K</span><span><svg viewBox="0 0 24 24"><path d="M3 20V4M3 20h18M7 16v-4m5 4V7m5 9v-6"/></svg> 97K</span><span>⬆</span></div></div></div><div class="xwr">🔁 Louis reposted</div><div class="xwp"><div class="xwa" style="background:#7a1f2b">S</div><div class="xwb"><div class="xwn"><b>Campus Safety Office</b><span>@uni_safety · 1d</span></div><div class="xwx">Reminder: any student can request a safe escort. Using an alpha command against anyone is a reportable offence under campus policy.</div><div class="xws"><span><svg viewBox="0 0 24 24"><path d="M20 11.5a7.5 7.5 0 0 1-8 7.5 8.8 8.8 0 0 1-3.6-.8L4 20l1.2-3.5A7.2 7.2 0 0 1 4 12c0-4.2 3.6-7.5 8-7.5s8 2.8 8 7Z"/></svg> 58</span><span><svg viewBox="0 0 24 24"><path d="m17 3 4 4-4 4M3 7h18M7 21l-4-4 4-4M21 17H3"/></svg> 3.4K</span><span><svg viewBox="0 0 24 24"><path d="M20.8 8.8c0 5-8.8 11-8.8 11s-8.8-6-8.8-11A4.8 4.8 0 0 1 12 6.2a4.8 4.8 0 0 1 8.8 2.6Z"/></svg> 8.1K</span><span><svg viewBox="0 0 24 24"><path d="M3 20V4M3 20h18M7 16v-4m5 4V7m5 9v-6"/></svg> 212K</span><span>⬆</span></div></div></div><div class="xwr">🔁 Louis reposted</div><div class="xwp"><div class="xwa" style="background:#2f7d5a">L</div><div class="xwb"><div class="xwn"><b>Legal Aid Now</b><span>@legalaidnow · 2h</span></div><div class="xwx">Free legal clinic this Saturday for tenants facing unlawful eviction. No appointment needed. 9 AM–1 PM, Room 204. ⚖️</div><div class="xws"><span><svg viewBox="0 0 24 24"><path d="M20 11.5a7.5 7.5 0 0 1-8 7.5 8.8 8.8 0 0 1-3.6-.8L4 20l1.2-3.5A7.2 7.2 0 0 1 4 12c0-4.2 3.6-7.5 8-7.5s8 2.8 8 7Z"/></svg> 18</span><span><svg viewBox="0 0 24 24"><path d="m17 3 4 4-4 4M3 7h18M7 21l-4-4 4-4M21 17H3"/></svg> 2.4K</span><span><svg viewBox="0 0 24 24"><path d="M20.8 8.8c0 5-8.8 11-8.8 11s-8.8-6-8.8-11A4.8 4.8 0 0 1 12 6.2a4.8 4.8 0 0 1 8.8 2.6Z"/></svg> 5.1K</span><span><svg viewBox="0 0 24 24"><path d="M3 20V4M3 20h18M7 16v-4m5 4V7m5 9v-6"/></svg> 96K</span><span>⬆</span></div></div></div><div class="xwr">🔁 Louis reposted</div><div class="xwp"><div class="xwa" style="background:#7a1f2b">I</div><div class="xwb"><div class="xwn"><b>Innocence Desk</b><span>@innocence_desk · 5h</span></div><div class="xwx">Update: a wrongful conviction was overturned today after 14 years. Justice delayed is justice denied, but today it arrived.</div><div class="xws"><span><svg viewBox="0 0 24 24"><path d="M20 11.5a7.5 7.5 0 0 1-8 7.5 8.8 8.8 0 0 1-3.6-.8L4 20l1.2-3.5A7.2 7.2 0 0 1 4 12c0-4.2 3.6-7.5 8-7.5s8 2.8 8 7Z"/></svg> 402</span><span><svg viewBox="0 0 24 24"><path d="m17 3 4 4-4 4M3 7h18M7 21l-4-4 4-4M21 17H3"/></svg> 9.8K</span><span><svg viewBox="0 0 24 24"><path d="M20.8 8.8c0 5-8.8 11-8.8 11s-8.8-6-8.8-11A4.8 4.8 0 0 1 12 6.2a4.8 4.8 0 0 1 8.8 2.6Z"/></svg> 31K</span><span><svg viewBox="0 0 24 24"><path d="M3 20V4M3 20h18M7 16v-4m5 4V7m5 9v-6"/></svg> 812K</span><span>⬆</span></div></div></div><div class="xwr">🔁 Louis reposted</div><div class="xwp"><div class="xwa" style="background:#14213d">L</div><div class="xwb"><div class="xwn"><b>Law Faculty</b><span>@lawfaculty · 1d</span></div><div class="xwx">Moot Court semifinals this Friday in the main hall. Come support our team. 🏛️</div><div class="xws"><span><svg viewBox="0 0 24 24"><path d="M20 11.5a7.5 7.5 0 0 1-8 7.5 8.8 8.8 0 0 1-3.6-.8L4 20l1.2-3.5A7.2 7.2 0 0 1 4 12c0-4.2 3.6-7.5 8-7.5s8 2.8 8 7Z"/></svg> 9</span><span><svg viewBox="0 0 24 24"><path d="m17 3 4 4-4 4M3 7h18M7 21l-4-4 4-4M21 17H3"/></svg> 128</span><span><svg viewBox="0 0 24 24"><path d="M20.8 8.8c0 5-8.8 11-8.8 11s-8.8-6-8.8-11A4.8 4.8 0 0 1 12 6.2a4.8 4.8 0 0 1 8.8 2.6Z"/></svg> 860</span><span><svg viewBox="0 0 24 24"><path d="M3 20V4M3 20h18M7 16v-4m5 4V7m5 9v-6"/></svg> 22K</span><span>⬆</span></div></div></div><div class="xwr">🔁 Louis reposted</div><div class="xwp"><div class="xwa" style="background:#1d4e89">C</div><div class="xwb"><div class="xwn"><b>Civil Rights Watch</b><span>@civilrights_watch · 2d</span></div><div class="xwx">Everyone deserves counsel. Public defenders are carrying caseloads far beyond safe limits. A thread on what is at stake. 🧵</div><div class="xws"><span><svg viewBox="0 0 24 24"><path d="M20 11.5a7.5 7.5 0 0 1-8 7.5 8.8 8.8 0 0 1-3.6-.8L4 20l1.2-3.5A7.2 7.2 0 0 1 4 12c0-4.2 3.6-7.5 8-7.5s8 2.8 8 7Z"/></svg> 211</span><span><svg viewBox="0 0 24 24"><path d="m17 3 4 4-4 4M3 7h18M7 21l-4-4 4-4M21 17H3"/></svg> 6.3K</span><span><svg viewBox="0 0 24 24"><path d="M20.8 8.8c0 5-8.8 11-8.8 11s-8.8-6-8.8-11A4.8 4.8 0 0 1 12 6.2a4.8 4.8 0 0 1 8.8 2.6Z"/></svg> 14K</span><span><svg viewBox="0 0 24 24"><path d="M3 20V4M3 20h18M7 16v-4m5 4V7m5 9v-6"/></svg> 390K</span><span>⬆</span></div></div></div><div class="xwr">🔁 Louis reposted</div><div class="xwp"><div class="xwa" style="background:#8a5a14">W</div><div class="xwb"><div class="xwn"><b>Workers Rights Hub</b><span>@workersrightshub · 4d</span></div><div class="xwx">Unpaid wages are theft. Know your rights: employers must pay for every hour worked.</div><div class="xws"><span><svg viewBox="0 0 24 24"><path d="M20 11.5a7.5 7.5 0 0 1-8 7.5 8.8 8.8 0 0 1-3.6-.8L4 20l1.2-3.5A7.2 7.2 0 0 1 4 12c0-4.2 3.6-7.5 8-7.5s8 2.8 8 7Z"/></svg> 77</span><span><svg viewBox="0 0 24 24"><path d="m17 3 4 4-4 4M3 7h18M7 21l-4-4 4-4M21 17H3"/></svg> 3.1K</span><span><svg viewBox="0 0 24 24"><path d="M20.8 8.8c0 5-8.8 11-8.8 11s-8.8-6-8.8-11A4.8 4.8 0 0 1 12 6.2a4.8 4.8 0 0 1 8.8 2.6Z"/></svg> 9.4K</span><span><svg viewBox="0 0 24 24"><path d="M3 20V4M3 20h18M7 16v-4m5 4V7m5 9v-6"/></svg> 204K</span><span>⬆</span></div></div></div><div class="xwr">🔁 Louis reposted</div><div class="xwp"><div class="xwa" style="background:#6b4fb3">T</div><div class="xwb"><div class="xwn"><b>Tenant Rights Hub</b><span>@tenantrightshub · 6d</span></div><div class="xwx">A landlord cannot lock you out or shut off your utilities. If it happens, document everything and call us.</div><div class="xws"><span><svg viewBox="0 0 24 24"><path d="M20 11.5a7.5 7.5 0 0 1-8 7.5 8.8 8.8 0 0 1-3.6-.8L4 20l1.2-3.5A7.2 7.2 0 0 1 4 12c0-4.2 3.6-7.5 8-7.5s8 2.8 8 7Z"/></svg> 54</span><span><svg viewBox="0 0 24 24"><path d="m17 3 4 4-4 4M3 7h18M7 21l-4-4 4-4M21 17H3"/></svg> 2.2K</span><span><svg viewBox="0 0 24 24"><path d="M20.8 8.8c0 5-8.8 11-8.8 11s-8.8-6-8.8-11A4.8 4.8 0 0 1 12 6.2a4.8 4.8 0 0 1 8.8 2.6Z"/></svg> 7.7K</span><span><svg viewBox="0 0 24 24"><path d="M3 20V4M3 20h18M7 16v-4m5 4V7m5 9v-6"/></svg> 166K</span><span>⬆</span></div></div></div><div class="xwr">🔁 Louis reposted</div><div class="xwp"><div class="xwa" style="background:#2f2f33">P</div><div class="xwb"><div class="xwn"><b>Pro Bono Society</b><span>@probonosociety · 1w</span></div><div class="xwx">Pro bono hours are open this term. Sign up to support families who cannot afford legal representation.</div><div class="xws"><span><svg viewBox="0 0 24 24"><path d="M20 11.5a7.5 7.5 0 0 1-8 7.5 8.8 8.8 0 0 1-3.6-.8L4 20l1.2-3.5A7.2 7.2 0 0 1 4 12c0-4.2 3.6-7.5 8-7.5s8 2.8 8 7Z"/></svg> 11</span><span><svg viewBox="0 0 24 24"><path d="m17 3 4 4-4 4M3 7h18M7 21l-4-4 4-4M21 17H3"/></svg> 419</span><span><svg viewBox="0 0 24 24"><path d="M20.8 8.8c0 5-8.8 11-8.8 11s-8.8-6-8.8-11A4.8 4.8 0 0 1 12 6.2a4.8 4.8 0 0 1 8.8 2.6Z"/></svg> 1.3K</span><span><svg viewBox="0 0 24 24"><path d="M3 20V4M3 20h18M7 16v-4m5 4V7m5 9v-6"/></svg> 41K</span><span>⬆</span></div></div></div><div class="xwr">🔁 Louis reposted</div><div class="xwp"><div class="xwa" style="background:#1b2a5a">D</div><div class="xwb"><div class="xwn"><b>Daily Campus</b><span>@dailycampus · 2w</span></div><div class="xwx">Moot Court team reaches the regional semifinals. Congratulations! 🏛️</div><div class="xws"><span><svg viewBox="0 0 24 24"><path d="M20 11.5a7.5 7.5 0 0 1-8 7.5 8.8 8.8 0 0 1-3.6-.8L4 20l1.2-3.5A7.2 7.2 0 0 1 4 12c0-4.2 3.6-7.5 8-7.5s8 2.8 8 7Z"/></svg> 64</span><span><svg viewBox="0 0 24 24"><path d="m17 3 4 4-4 4M3 7h18M7 21l-4-4 4-4M21 17H3"/></svg> 412</span><span><svg viewBox="0 0 24 24"><path d="M20.8 8.8c0 5-8.8 11-8.8 11s-8.8-6-8.8-11A4.8 4.8 0 0 1 12 6.2a4.8 4.8 0 0 1 8.8 2.6Z"/></svg> 3.2K</span><span><svg viewBox="0 0 24 24"><path d="M3 20V4M3 20h18M7 16v-4m5 4V7m5 9v-6"/></svg> 88K</span><span>⬆</span></div></div></div></div><div class="xwnav"><span aria-label="Home"><svg viewBox="0 0 24 24"><path d="M3 10.8 12 3l9 7.8V21h-6v-6h-6v6H3z"/></svg></span><span aria-label="Search"><svg viewBox="0 0 24 24"><circle cx="10.8" cy="10.8" r="6.8"/><path d="m16 16 5 5"/></svg></span><span aria-label="Grok"><svg viewBox="0 0 24 24"><path d="M4 4 20 20M20 4 4 20"/><path d="M12 2v20M2 12h20" opacity=".45"/></svg></span><span aria-label="Notifications"><svg viewBox="0 0 24 24"><path d="M18 9a6 6 0 0 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9M10 21h4"/></svg></span><span aria-label="Messages"><svg viewBox="0 0 24 24"><path d="M4 5h16v12H9l-5 4z"/></svg></span></div></div><a class="hbk" data-passage="Home Screen"></a><div class="home"></div></div></div></div>



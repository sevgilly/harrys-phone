setTimeout(function(){var nl=$('.nl');if(!nl.length||$('.nnew').length)return;nl.css('top','340px').prepend('<div class="nt nnew"><div class="ic sm wa"><svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2" stroke-linejoin="round"><path d="M3.5 20.5l1.2-4.2A8.5 8.5 0 1 1 8 19.4l-4.5 1.1z"/><path d="M9 8c0 3.5 3 6.5 6.5 6.5l1-1.7-2-1-1 .9c-.9-.4-1.8-1.3-2.2-2.2l.9-1-1-2L9 8z" fill="#fff" stroke="none"/></svg></div><div style="flex:1"><div class="nh"><b>Zayn</b><span>now</span></div><div class="nm">hey, Louis. It’s Zayn, remember me?</div></div></div>');beep();buzz();},2500);});

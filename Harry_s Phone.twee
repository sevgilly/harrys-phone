function listV(){var s='<div class="wh"><span class="bl">Edit</span><span class="wi">'+W('cam',26)+W('plus',26)+'</span></div><div class="wt">Chats</div><div class="wl"><div class="wsb">'+W('search',15,'#8e8e93',2)+'<span>Search</span></div>';
 CH.forEach(function(c){var m=c.m.filter(function(x){return x[0]!='d';}),l=m[m.length-1],pv=(l[0]=='o'?'<span class="tk">✓✓</span> ':(c.g?l[1]+': ':''))+l[2],u=c.u||0;
 s+='<div class="wr" data-w="open" data-k="'+c.id+'">'+wav(c,52)+'<div class="wrb"><div class="wr1"><b>'+c.n+'</b><span class="'+(u&&!c.mu?'gn':'')+'">'+c.t+'</span></div><div class="wr2"><span class="pv">'+pv+'</span><span class="wr3">'+(c.mu?'<span class="mi">'+W('mute',15,'#8e8e93',1.8)+'</span>':'')+(u?'<i class="ub'+(c.mu?' gy':'')+'">'+u+'</i>':'')+'</span></div></div></div>';});
 return s+'</div>'+tabs('c');}
function chatV(){var c=byId(S.c);
 var h='<div class="wch0"><span data-w="back" class="wbk">'+W('back',26,'#007aff',2.4)+'</span>'+wav(c,36)+'<div class="nm"><b>'+c.n+'</b><span>'+(c.g?c.mem:'online')+'</span></div>'+W('vid',26)+W('ph',24)+'</div><div class="wbody"><div class="wenc">🔒 Messages and calls are end-to-end encrypted. No one outside of this chat can read or listen to them.</div>';
 c.m.forEach(function(x){if(x[0]=='d'){h+='<div class="wdate">'+x[1]+'</div>';return;}var o=x[0]=='o';h+='<div class="wmsg '+(o?'o':'i')+'">'+(c.g&&!o?'<div class="ws" style="color:'+col(x[1])+'">'+x[1]+'</div>':'')+'<span>'+x[2]+'</span><em>'+x[3]+(o?' <u>✓✓</u>':'')+'</em></div>';});
 h+='</div><div class="wfoot">'+W('plus',28,'#007aff')+'<div class="wfi">Message</div>'+W('cam',26,'#007aff')+W('mic',26,'#007aff')+'</div>';return h;}
function setV(){var s='<div class="wt" style="padding-top:12px">Settings</div><div class="wl"><div class="wr" style="padding:12px 16px">'+wav({id:'me',ini:'H',bg:'#007aff'},64)+'<div class="wrb" style="border:0"><div class="wr1"><b>Harry</b></div><div class="wr2"><span class="pv">Busy.</span></div></div></div>';
 ['Starred Messages','Linked Devices','Account','Privacy','Chats','Notifications','Storage and Data'].forEach(function(x){s+='<div class="wlr"><b style="font-size:16px">'+x+'</b>'+W('chev',16,'#c7c7cc')+'</div>';});
 return s+'</div>'+tabs('s');}
function render(){var v=S.v=='chat'?chatV():(S.v=='set'?setV():listV());$('#waroot').html(v);
 var b=document.querySelector&&document.querySelector('.wbody');if(b)b.scrollTop=b.scrollHeight;}
function mount(){S.v='list';render();$(document).off('click.hph.wa').on('click.hph.wa','#waroot [data-w]',function(){var t=$(this),d=t.data('w'),k=t.data('k');
 if(d=='open'){S.v='chat';S.c=k;byId(k).u=0;}else if(d=='back'){S.v='list';}else if(d=='tab'){S.v=k=='s'?'set':'list';}render();});}
return {mount:mount};})();
})();


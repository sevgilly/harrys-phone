function fm(n){return String(n).replace(/\B(?=(\d{3})+(?!\d))/g,',');}
function cnt(l,id){return fm(parseInt(String(l).replace(/,/g,''),10)+(LK[id]?1:0));}
function hrt(id){return '<span data-a="lk" data-k="'+id+'">'+(LK[id]?I('heart',26,'#ed4956',1.8,'#ed4956'):I('heart',26))+'</span>';}

window.RL=(function(){
function esc(x){return String(x||'').replace(/[&<>\"']/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;',"'":'&#39;'}[c];});}
function card(r,i){var vid=r.src?'<video class="rlv" src="'+esc(r.src)+'" muted autoplay loop playsinline preload="metadata"></video>':'<div class="rls">'+esc(r.s||'▶')+'</div>';
 return '<div class="rlc" data-reel="'+esc(r.id||'')+'">'+vid+'<div class="rlg"></div><div class="rla"><div class="rlbtn" data-r="like"><i>♡</i><b>'+esc(r.l||'1.2K')+'</b></div><div class="rlbtn"><i>💬</i><b>'+esc(r.m||'48')+'</b></div><div class="rlbtn" data-r="share"><i>➤</i><b>Share</b></div><div class="rlbtn"><i>⋯</i></div></div>'
 +'<div class="rli"><div class="rlu"><span class="rlav">'+esc((r.u||'u').charAt(0).toUpperCase())+'</span><b>@'+esc(r.u||'user')+'</b><span class="rlfl">Follow</span></div><div class="rlt">'+esc(r.c||'')+'</div><div class="rlm">♫ Original audio</div></div></div>';}
function list(){return window.REELS||[];}
function html(){var a=list();return '<div class="rlf">'+(a.length?a.map(card).join(''):'<div class="rl-empty">Add MP4 clips to the videos folder to fill Harry’s Reels.</div>')+'</div>';}
var OB=null;
function open(id){var r=list().filter(function(x){return x.id===id;})[0];if(!r)return;close();var el=document.createElement('div');el.className='rl-modal';el.innerHTML='<button class="rl-modal-close" type="button" aria-label="Close">×</button><video class="rl-modal-video" src="'+esc(r.src)+'" controls autoplay playsinline></video><div class="rl-modal-caption"><b>@'+esc(r.u)+'</b><span>'+esc(r.c)+'</span></div>';(document.querySelector('#igroot')||document.body).appendChild(el);var v=el.querySelector('video');var p=v.play();if(p&&p.catch)p.catch(function(){});}
function close(){var el=document.querySelector('.rl-modal');if(el){var v=el.querySelector('video');if(v)v.pause();el.remove();}}
function init(){var f=document.querySelector('.rlf');if(!f)return;if(OB)OB.disconnect();
 var videos=f.querySelectorAll('video.rlv');videos.forEach(function(v){v.addEventListener('error',function(){var c=v.closest('.rlc');if(c&&!c.querySelector('.rl-missing')){var n=document.createElement('div');n.className='rl-missing';n.innerHTML='<b>Video file not found</b><span>'+esc(v.getAttribute('src'))+'</span>';c.appendChild(n);}});});
 if(!('IntersectionObserver' in window)){if(videos[0]){var p=videos[0].play();if(p&&p.catch)p.catch(function(){});}return;}
 OB=new IntersectionObserver(function(es){es.forEach(function(e){var v=e.target.querySelector('video');if(!v)return;if(e.isIntersecting&&e.intersectionRatio>.6){var p=v.play();if(p&&p.catch)p.catch(function(){});}else{v.pause();}});},{root:f,threshold:[0,.6,1]});
 f.querySelectorAll('.rlc').forEach(function(c){OB.observe(c);});
 f.querySelectorAll('.rlc[data-reel]').forEach(function(c){c.addEventListener('click',function(ev){if(ev.target.closest('.rlbtn'))return;});});
}
$(document).on('click.rl','#igroot .rlbtn[data-r="like"]',function(){var b=$(this);b.toggleClass('on');b.find('i').text(b.hasClass('on')?'♥':'♡');});
$(document).on('dblclick.rl','#igroot .rlc',function(){var c=$(this),b=c.find('.rlbtn[data-r="like"]');if(!b.hasClass('on')){b.addClass('on');b.find('i').text('♥');}var h=$('<div class="rlh">♥</div>');c.append(h);setTimeout(function(){h.remove();},700);});
$(document).on('click.rl','#igroot .rlv',function(){this.muted=!this.muted;});
$(document).on('click.rl','#igroot .thc.reel',function(){var id=$(this).attr('data-reel');if(id)open(id);});
$(document).on('click.rl','.rl-modal-close',close);
$(document).on('click.rl','.rl-modal',function(e){if(e.target===this)close();});
return {html:html,init:init,open:open,close:close};})();

/* ===== fit the phone to any screen (iPhone Safari included) ===== */
(function(){
 function fit(){var vv=window.visualViewport,w=vv?vv.width:window.innerWidth,h=vv?vv.height:window.innerHeight,
  s=Math.min(1,(w-6)/420,(h-6)/890),d=document.querySelector('.device');
  if(d){d.style.transform='scale('+s.toFixed(3)+')';}}
 $(document).on(':passagedisplay',function(){fit();setTimeout(fit,60);setTimeout(fit,400);});
 window.addEventListener('resize',fit);window.addEventListener('orientationchange',function(){setTimeout(fit,200);});
 if(window.visualViewport){window.visualViewport.addEventListener('resize',fit);}
})();



/* Mobile Safari/Chrome tap bridge for SugarCube links and app controls. */
(function(){
  function fitPhone(){
    var w=Math.max(280,window.innerWidth||1280),h=Math.max(500,window.innerHeight||900);
    var scale=Math.min((w-24)/420,(h-24)/890,1);
    document.documentElement.style.setProperty('--mobile-phone-scale',String(Math.max(.55,scale)));
  }
  fitPhone();
  window.addEventListener('resize',fitPhone,{passive:true});
  window.addEventListener('orientationchange',function(){setTimeout(fitPhone,120);},{passive:true});

  var selector='a[data-passage],#igroot [data-a],#waroot [data-w],#nroot [data-n],#phroot [data-p],#camroot [data-c],#mproot [data-m],#rmroot [data-r],#strroot .str,#strroot .stc,.nnew,.cksw,.sb.pw,.qb.r';
  var start=null;
  document.addEventListener('touchstart',function(e){
    var t=e.target,el=t&&t.closest?t.closest(selector):null;
    if(!el){start=null;return;}
    var p=e.touches&&e.touches[0];
    if(p)start={el:el,x:p.clientX,y:p.clientY};
  },{passive:true,capture:true});
  document.addEventListener('touchend',function(e){
    if(!start)return;
    var p=e.changedTouches&&e.changedTouches[0],a=start;start=null;
    if(!p||Math.abs(p.clientX-a.x)>12||Math.abs(p.clientY-a.y)>12)return;
    if(!document.documentElement.contains(a.el))return;
    /* Prevent the browser's follow-up synthetic click; dispatch one delegated click instead. */
    e.preventDefault();
    if(window.jQuery)window.jQuery(a.el).trigger('click');
    else if(typeof a.el.click==='function')a.el.click();
  },{passive:false,capture:true});
})();

/* ===== Harry X: persistent DMs, inbox previews, tabs and posting ===== */
(function(){
  function readStore(key,fallback){try{var v=sessionStorage.getItem(key);return v?JSON.parse(v):fallback;}catch(e){return fallback;}}
  function writeStore(key,value){try{sessionStorage.setItem(key,JSON.stringify(value));}catch(e){}}
  window.XDM=window.XDM||readStore('harry-x-dm-v31',{});
  window.XPOSTS=window.XPOSTS||readStore('harry-x-posts-v31',[]);
  var labels={zee:'Zee',niall:'Niall',liam:'Liam',kingsbridge:'Kingsbridge FC'};
  function xdmAppend(body,item){
    var bubble=document.createElement('div');bubble.className='xdmb out';
    var p=document.createElement('p');p.textContent=item.text;
    var tm=document.createElement('small');tm.textContent=item.time;
    bubble.appendChild(p);bubble.appendChild(tm);body.appendChild(bubble);
  }
  function updateInbox(){
    var rows=document.querySelectorAll('.xw[data-harry-x="1"] .xmsg-row');
    rows.forEach(function(row){
      var name=row.querySelector('.xmsg-copy b');if(!name)return;
      var key=Object.keys(labels).filter(function(k){return labels[k]===name.textContent;})[0];
      var list=key&&window.XDM[key];if(!list||!list.length)return;
      var preview=row.querySelector('.xmsg-copy p'),stamp=row.querySelector('.xmsg-copy span');
      if(preview)preview.textContent=list[list.length-1].text;
      if(stamp)stamp.textContent=list[list.length-1].time;
    });
  }
  $(document).off('click.hxsend').on('click.hxsend','.xw[data-harry-x="1"] [data-x-send]',function(){
    var input=document.querySelector('.xw[data-harry-x="1"] #xchat-input'),body=document.querySelector('.xw[data-harry-x="1"] #xchat-body');
    if(!input||!body)return;
    var value=(input.value||'').trim(),key=body.getAttribute('data-x-chat');
    if(!value||!key)return;
    var item={text:value,time:new Date().toLocaleTimeString([], {hour:'numeric',minute:'2-digit'})};
    window.XDM[key]=window.XDM[key]||[];window.XDM[key].push(item);
    writeStore('harry-x-dm-v31',window.XDM);xdmAppend(body,item);
    input.value='';body.scrollTop=body.scrollHeight;updateInbox();input.focus();
  });
  $(document).off('keydown.hxsend').on('keydown.hxsend','.xw[data-harry-x="1"] #xchat-input',function(e){
    if(e.key==='Enter'&&!e.shiftKey){e.preventDefault();$('.xw[data-harry-x="1"] [data-x-send]').trigger('click');}
  });
  function makePost(text){
    var card=document.createElement('div');card.className='xw-new-post';
    var av=document.createElement('div');av.className='xwa';av.textContent='H';
    var copy=document.createElement('div');copy.style.minWidth='0';copy.style.flex='1';
    var head=document.createElement('div');head.className='xwn';
    var name=document.createElement('b');name.textContent='Harry';var handle=document.createElement('span');handle.textContent='@hstyles · now';head.appendChild(name);head.appendChild(handle);
    var body=document.createElement('div');body.className='xwx';body.textContent=text;
    var actions=document.createElement('div');actions.className='xws';actions.textContent='♡  0     ↻  0     ♡  0     ···';
    copy.appendChild(head);copy.appendChild(body);copy.appendChild(actions);card.appendChild(av);card.appendChild(copy);return card;
  }
  function renderPosts(){
    var feed=document.querySelector('.xw[data-harry-x="1"] .xwf');if(!feed)return;
    var posts=window.XPOSTS||[];
    posts.forEach(function(post){if(!feed.querySelector('[data-x-post-id="'+post.id+'"]')){var node=makePost(post.text);node.setAttribute('data-x-post-id',post.id);feed.insertBefore(node,feed.firstChild);}});
  }
  $(document).off('click.hxcompose').on('click.hxcompose','.xw[data-harry-x="1"] .xw-top-action,.xw[data-harry-x="1"] .xwfab',function(){
    var root=document.querySelector('.xw[data-harry-x="1"]');if(!root||root.querySelector('.xw-compose-shade'))return;
    var shade=document.createElement('div');shade.className='xw-compose-shade';
    var card=document.createElement('div');card.className='xw-compose-card';
    var head=document.createElement('div');head.className='xw-compose-head';head.textContent='New post';
    var close=document.createElement('button');close.type='button';close.className='xw-compose-close';close.textContent='×';close.setAttribute('aria-label','Close');head.appendChild(close);
    var area=document.createElement('textarea');area.maxLength=280;area.placeholder="What's happening?";
    var foot=document.createElement('div');foot.className='xw-compose-foot';
    var send=document.createElement('button');send.type='button';send.className='xw-compose-submit';send.textContent='Post';foot.appendChild(send);
    card.appendChild(head);card.appendChild(area);card.appendChild(foot);shade.appendChild(card);root.appendChild(shade);area.focus();
    close.addEventListener('click',function(){shade.remove();});
    shade.addEventListener('click',function(e){if(e.target===shade)shade.remove();});
    send.addEventListener('click',function(){var value=area.value.trim();if(!value)return;var post={id:'p'+Date.now(),text:value};window.XPOSTS.unshift(post);writeStore('harry-x-posts-v31',window.XPOSTS);shade.remove();renderPosts();});
  });
  $(document).off('input.hxsearch').on('input.hxsearch','.xw[data-harry-x="1"] #xmsg-search-input',function(){
    var q=(this.value||'').trim().toLowerCase();
    document.querySelectorAll('.xw[data-harry-x="1"] .xmsg-row').forEach(function(row){row.hidden=q&&!row.textContent.toLowerCase().includes(q);});
  });
  $(document).off('click.hxtabs').on('click.hxtabs','.xw[data-harry-x="1"] .xwtb span',function(){
    var tab=this,bar=tab.parentElement,root=bar.closest('.xw');if(!root)return;
    bar.querySelectorAll('span').forEach(function(s){s.classList.toggle('on',s===tab);});
    var label=tab.textContent.trim(),feed=root.querySelector('.xwf');if(!feed)return;
    var empty=feed.querySelector('.xw-empty');if(empty)empty.remove();
    var items=Array.prototype.slice.call(feed.querySelectorAll('.xnitem,.xmsg-row,.xwp'));
    items.forEach(function(el){el.hidden=false;});
    if(root.querySelector('.xwnav')&&root.querySelector('.xw-top-action,.xwfab')){
      items.forEach(function(el){var name=el.querySelector('.xwn b');var account=name&&name.textContent.trim();el.hidden=label==='Following'?!['Campus Confessions','University Football','Kingsbridge FC'].includes(account):false;});
    }else if(items.some(function(el){return el.classList.contains('xnitem');})){
      items.forEach(function(el){var txt=el.textContent;el.hidden=label==='Verified'?!txt.includes('University Football'):label==='Mentions'?!txt.includes('mentioned you'):false;});
    }else if(items.some(function(el){return el.classList.contains('xmsg-row');})){
      items.forEach(function(el){el.hidden=label==='Unread'?!el.querySelector('.xmsg-dot'):label==='Requests'?true:false;});
      if(label==='Requests'){var msg=document.createElement('div');msg.className='xw-empty';msg.textContent='No message requests right now.';feed.appendChild(msg);}
    }else if(['Replies','Highlights','Media','Likes'].includes(label)){
      items.forEach(function(el){var own=!!(el.querySelector('.xwn b')&&el.querySelector('.xwn b').textContent.trim()==='Harry');var media=!!el.querySelector('.xwi');el.hidden=label==='Media'?!media:label==='Highlights'?!own:label==='Replies'||label==='Likes';});
      if(!items.some(function(el){return !el.hidden;})){var msg=document.createElement('div');msg.className='xw-empty';msg.textContent=label==='Replies'?'No replies yet.':label==='Likes'?'Posts Harry likes will appear here.':'Nothing to show here yet.';feed.appendChild(msg);}
    }
  });
  $(document).off('click.hxengage').on('click.hxengage','.xw[data-harry-x="1"] .xws span',function(){
    var spans=this.parentElement.querySelectorAll('span'),index=Array.prototype.indexOf.call(spans,this);if(index!==1&&index!==2)return;
    var raw=this.textContent.trim(),match=raw.match(/([\d,.]+)\s*$/),n=match?parseFloat(match[1].replace(/,/g,'')):0;
    var active=index===2?this.classList.toggle('x-liked'):this.classList.toggle('x-reposted');
    if(match){var next=Math.max(0,n+(active?1:-1));var formatted=next>=1000?(next/1000).toFixed(1)+'K':String(next);this.childNodes[this.childNodes.length-1].textContent=' '+formatted;}
  });
  $(document).off(':passagedisplay.hxdm').on(':passagedisplay.hxdm',function(){
    if(!document.querySelector('.xw[data-harry-x="1"]'))return;
    var body=document.querySelector('.xw[data-harry-x="1"] #xchat-body');
    if(body){var key=body.getAttribute('data-x-chat'),items=window.XDM&&window.XDM[key]||[];items.forEach(function(item){xdmAppend(body,item);});body.scrollTop=body.scrollHeight;}
    updateInbox();renderPosts();
  });
})();

/* ===== Harry secondary-page app interactions ===== */
(function(){
  var calc={current:'0',stored:null,op:null,reset:false};
  function showCalc(){var el=document.getElementById('hcalc-display');if(el)el.textContent=calc.current;}
  function calculate(){var a=Number(calc.stored),b=Number(calc.current);if(calc.op==='+')return a+b;if(calc.op==='−')return a-b;if(calc.op==='×')return a*b;if(calc.op==='÷')return b===0?'Error':a/b;return b;}
  $(document).off('click.hcalc').on('click.hcalc','[data-calc]',function(){
    var k=this.getAttribute('data-calc');
    if(k==='AC'){calc={current:'0',stored:null,op:null,reset:false};}
    else if(k==='+/-'){if(calc.current!=='0')calc.current=String(-Number(calc.current));}
    else if(k==='%'){calc.current=String(Number(calc.current)/100);}
    else if(['+','−','×','÷'].includes(k)){calc.stored=calc.current;calc.op=k;calc.reset=true;}
    else if(k==='='){if(calc.op){var result=calculate();calc.current=String(result);if(calc.current.length>12)calc.current=Number(calc.current).toPrecision(8);calc.stored=null;calc.op=null;calc.reset=true;}}
    else if(k==='.'){if(calc.reset){calc.current='0.';calc.reset=false;}else if(!calc.current.includes('.'))calc.current+='.';}
    else{if(calc.reset||calc.current==='0'||calc.current==='Error'){calc.current=k;calc.reset=false;}else if(calc.current.length<12)calc.current+=k;}
    showCalc();
  });
  $(document).off(':passagedisplay.hcalc').on(':passagedisplay.hcalc',function(){if(document.getElementById('hcalc-display'))showCalc();});
  $(document).off('click.hshortcut').on('click.hshortcut','[data-shortcut]',function(){
    var root=this.closest('.happ');if(!root)return;
    var old=root.querySelector('.happ-toast');if(old)old.remove();
    var toast=document.createElement('div');toast.className='happ-toast';toast.textContent=this.getAttribute('data-shortcut')+' · ready';root.appendChild(toast);
  });
})();

:: StoryStylesheet [stylesheet]
:root{box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
*{box-sizing:border-box}
body{margin:0;min-height:100vh;display:flex;align-items:center;justify-content:center;background:radial-gradient(circle at 50% 30%,#1c1c22,#050507);font-family:-apple-system,BlinkMacSystemFont,"SF Pro Display","SF Pro Text","Helvetica Neue",Arial,sans-serif;color:#fff;overflow:hidden;-webkit-font-smoothing:antialiased}

/* ---- CİHAZ: iPhone 18 Pro (402x874) ---- */
.device{position:relative;width:420px;height:890px;border-radius:68px;padding:4px;flex:none;
background:linear-gradient(145deg,#a1a1a6 0%,#48484a 25%,#8e8e93 50%,#3a3a3c 75%,#98989d 100%);
box-shadow:0 0 0 1px #1c1c1e,0 40px 90px rgba(0,0,0,.7),inset 0 0 3px rgba(255,255,255,.6)}
.bezel{width:100%;height:100%;background:#000;border-radius:64px;padding:7px}
.screen{position:relative;width:402px;height:874px;border-radius:57px;overflow:hidden;
background:
 radial-gradient(120% 70% at 15% 12%,#ff9a8b 0%,transparent 55%),
 radial-gradient(110% 70% at 90% 30%,#6a5cff 0%,transparent 60%),
 radial-gradient(120% 80% at 40% 100%,#ff6a88 0%,transparent 60%),
 linear-gradient(170deg,#2b1f6b,#12123a)}
/* yan tuşlar */
.sb{position:absolute;width:4px;background:linear-gradient(90deg,#6e6e73,#2c2c2e);border-radius:2px}
.sb.act{left:-3px;top:130px;height:30px}
.sb.v1{left:-3px;top:190px;height:58px}
.sb.v2{left:-3px;top:260px;height:58px}
.sb.pw{right:-3px;top:230px;height:92px;background:linear-gradient(270deg,#6e6e73,#2c2c2e)}
.sb.cc{right:-3px;top:560px;height:70px;background:linear-gradient(270deg,#6e6e73,#2c2c2e)}

/* Dynamic Island (iPhone 18 Pro: daha küçük) */
.island{position:absolute;top:12px;left:50%;transform:translateX(-50%);width:98px;height:29px;background:#000;border-radius:20px;z-index:9}
.island::after{content:"";position:absolute;right:9px;top:9px;width:11px;height:11px;border-radius:50%;background:radial-gradient(circle at 35% 35%,#2a3550,#06080f 70%)}

/* durum çubuğu */
.status{position:absolute;top:0;left:0;right:0;height:54px;padding:19px 32px 0 40px;display:flex;justify-content:space-between;font-size:16px;font-weight:600;letter-spacing:-.2px;z-index:8}
.status .r{display:flex;gap:6px;align-items:center}
.sig{display:flex;gap:2px;align-items:flex-end;height:12px}
.sig i{width:3.5px;background:#fff;border-radius:1px}
.sig i:nth-child(1){height:4px}.sig i:nth-child(2){height:6.5px}.sig i:nth-child(3){height:9px}.sig i:nth-child(4){height:12px}
.wifi{width:17px;height:12px}
.bat{position:relative;width:27px;height:13px;border-radius:4.5px;background:rgba(255,255,255,.35);overflow:hidden;display:flex;align-items:center;justify-content:center;font-size:10px;font-weight:700;color:#000}
.bat::before{content:"";position:absolute;left:0;top:0;bottom:0;width:82%;background:#fff}
.bat span{position:relative;z-index:1;mix-blend-mode:normal}
.bat-tip{width:2px;height:5px;border-radius:0 1px 1px 0;background:rgba(255,255,255,.4);margin-left:-3px}

/* ızgara */
.grid{position:absolute;top:72px;left:0;right:0;padding:0 26px;display:grid;grid-template-columns:repeat(4,1fr);gap:21px 0;justify-items:center}
.ap{position:relative;width:70px;text-align:center;cursor:pointer}
.ic{position:relative;width:62px;height:62px;border-radius:16px;display:flex;align-items:center;justify-content:center;overflow:hidden;
box-shadow:0 3px 8px rgba(0,0,0,.28),0 0 0 .5px rgba(0,0,0,.25),inset 0 0 0 .6px rgba(255,255,255,.35),inset 0 1.5px 1px rgba(255,255,255,.55)}
.ic::after{content:"";position:absolute;inset:0;background:linear-gradient(175deg,rgba(255,255,255,.32) 0%,rgba(255,255,255,0) 45%,rgba(0,0,0,.08) 100%);pointer-events:none}
.ic svg{position:relative;z-index:1;width:34px;height:34px;filter:drop-shadow(0 1px 1px rgba(0,0,0,.18))}
.lb{margin-top:6px;font-size:12px;font-weight:500;letter-spacing:-.1px;text-shadow:0 1px 3px rgba(0,0,0,.35);white-space:nowrap}
.badge{position:absolute;top:-7px;right:-1px;min-width:24px;height:24px;border-radius:12px;background:#ff3b30;font-size:15px;font-weight:500;display:flex;align-items:center;justify-content:center;padding:0 7px;box-shadow:0 1px 4px rgba(0,0,0,.35);z-index:3}

.insta{background:radial-gradient(circle at 30% 107%,#fdf497 0%,#fdf497 5%,#fd5949 45%,#d6249f 60%,#285aeb 90%)}
.xx{background:linear-gradient(#1a1a1a,#000)}
.wa{background:linear-gradient(#5af575,#12b822)}
.mus{background:linear-gradient(#fb5c74,#fa233b)}
.tel{background:linear-gradient(#67e87f,#1bb52d)}
.msg{background:linear-gradient(#67e87f,#1bb52d)}
.saf{background:linear-gradient(#fdfdfd,#dfe3ea)}
.cam{background:linear-gradient(#b4b4b9,#6e6e73)}
.set{background:linear-gradient(#b4b4b9,#7b7b80)}
.clk{background:#000}
.pho{background:#fff}

/* sayfa noktaları, arama, dock */
.dots{position:absolute;bottom:128px;width:100%;display:flex;justify-content:center;gap:9px}
.dots i{width:7px;height:7px;border-radius:50%;background:rgba(255,255,255,.4)}
.dots i.on{background:#fff}
.search{position:absolute;bottom:100px;left:50%;transform:translateX(-50%);padding:7px 20px;border-radius:20px;font-size:13px;font-weight:500;display:flex;gap:6px;align-items:center;
background:rgba(255,255,255,.18);backdrop-filter:blur(30px) saturate(1.6);-webkit-backdrop-filter:blur(30px) saturate(1.6);box-shadow:inset 0 0 0 .6px rgba(255,255,255,.35),inset 0 1px 1px rgba(255,255,255,.4)}
.dock{position:absolute;bottom:14px;left:14px;right:14px;height:90px;border-radius:38px;display:flex;justify-content:space-around;align-items:center;padding:0 6px;
background:rgba(255,255,255,.2);backdrop-filter:blur(40px) saturate(1.8);-webkit-backdrop-filter:blur(40px) saturate(1.8);
box-shadow:0 8px 24px rgba(0,0,0,.18),inset 0 0 0 .7px rgba(255,255,255,.4),inset 0 1.5px 1px rgba(255,255,255,.5)}
.dock .ap{width:66px}
.home{position:absolute;bottom:6px;left:50%;transform:translateX(-50%);width:138px;height:5px;border-radius:3px;background:#fff;z-index:9}


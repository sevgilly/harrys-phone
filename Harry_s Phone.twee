reels:'<rect x="3" y="3" width="18" height="18" rx="5"/><path d="M3 9h18M9 3l3 6M15 3l3 6"/><path d="m10 12.5 4 2.5-4 2.5z"/>',
dm:'<path d="M21.5 3 2.5 10.5l7 3 3 7z"/><path d="m21.5 3-12 10.5"/>',
heart:'<path d="M12 21s-8.5-5.3-8.5-11.5A4.8 4.8 0 0 1 12 6.5a4.8 4.8 0 0 1 8.5 3C20.5 15.7 12 21 12 21z"/>',
plus:'<rect x="3" y="3" width="18" height="18" rx="5"/><path d="M12 8v8M8 12h8"/>',
menu:'<path d="M4 7h16M4 12h16M4 17h16"/>',
cmt:'<path d="M21 11.5a8.5 8.5 0 0 1-12.5 7.5L3 20.5l1.5-5.2A8.5 8.5 0 1 1 21 11.5z"/>',
bm:'<path d="M6 3h12v18l-6-4.5L6 21z"/>',
grid:'<rect x="3" y="3" width="18" height="18"/><path d="M3 9h18M3 15h18M9 3v18M15 3v18"/>',
tag:'<rect x="4" y="4" width="16" height="16"/><circle cx="12" cy="10" r="3"/><path d="M6 19c1-3 3-4 6-4s5 1 6 4"/>',
back:'<path d="m15 5-7 7 7 7"/>',x:'<path d="M5 5l14 14M19 5 5 19"/>',chev:'<path d="m6 9 6 6 6-6"/>',
search:'<circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/>',
dots:'<circle cx="5" cy="12" r="1.3"/><circle cx="12" cy="12" r="1.3"/><circle cx="19" cy="12" r="1.3"/>'};
function I(n,s,c,w,f){return '<svg viewBox="0 0 24 24" width="'+s+'" height="'+s+'" fill="'+(f||'none')+'" stroke="'+(c||'#000')+'" stroke-width="'+(w||1.8)+'" stroke-linecap="round" stroke-linejoin="round">'+D[n]+'</svg>';}
function av(src,s,t){return '<div class="av" style="width:'+s+'px;height:'+s+'px;'+(src?"background-image:url('"+src+"')":'')+'">'+(src?'':(t||'').charAt(0).toUpperCase())+'</div>';}
function ph(a,b){return 'background:linear-gradient(135deg,'+a+','+b+')';}
function actions(){return '<div class="pa">'+I('heart',26)+I('cmt',26)+I('dm',26)+'<span class="gr">'+I('bm',26)+'</span></div>';}
function post(u,cap,lk){return '<div class="po"><div class="pr">'+av('',32,u)+'<b>'+u+'</b><span class="gr">'+I('dots',20)+'</span></div><div class="pi" style="'+ph('#dcdce1','#b9b9c2')+'"></div>'+actions()+'<div class="pt"><b>'+lk+' likes</b></div><div class="pt"><b>'+u+'</b> '+cap+'</div><div class="pt mu">View all comments</div><div class="pt mu sm">2 hours ago</div></div>';}
function stats(p,f,g){return '<div class="sts"><div><b>'+p+'</b>posts</div><div><b>'+f+'</b>followers</div><div><b>'+g+'</b>following</div></div>';}
function grid(n){var s='<div class="pg">';for(var i=0;i<n;i++)s+='<div class="pc" style="'+ph('#ececef','#d3d3da')+'"></div>';return s+'</div>';}
function tabs2(){return '<div class="tb2"><span class="on">'+I('grid',24)+'</span><span>'+I('reels',24)+'</span><span>'+I('tag',24)+'</span></div>';}
function fm(n){return String(n).replace(/\B(?=(\d{3})+(?!\d))/g,',');}
function cnt(l,id){return fm(parseInt(String(l).replace(/,/g,''),10)+(LK[id]?1:0));}
function hrt(id){return '<span data-a="lk" data-k="'+id+'">'+(LK[id]?I('heart',26,'#ed4956',1.8,'#ed4956'):I('heart',26))+'</span>';}
function loginV(){return '<div class="sh-bg" data-a="lc"></div><div class="lg">'+av(AV.priv,72)+'<b>'+ACC.priv.u+'</b><div class="mu">Enter your password to switch accounts</div><input id="igpw" type="password" placeholder="Hint: the red one’s plate" autocomplete="off">'+(S.err?'<div class="er">The password you entered is incorrect.</div>':'')+'<div class="lgb" data-a="login">Log in</div><div class="bl">Forgot password?</div><div class="mu lc" data-a="lc">Cancel</div></div>';}
function ava(u,s){var k=PK[u];return av(k?AV[k]:'',s,u);}
function fpost(k){var p=P[k],x=p.ps[0],id=k+':0';return '<div class="po"><div class="pr" data-a="pu" data-k="'+k+'">'+av(AV[p.a],32)+'<b>'+p.u+'</b><span class="gr">'+I('dots',20)+'</span></div><div class="pi img" data-lk="'+id+'" style="background-image:url(\''+IM[x.k]+'\')"></div><div class="pa">'+hrt(id)+I('dm',26)+'<span class="gr">'+I('bm',26)+'</span></div><div class="pt"><b>'+cnt(x.l,id)+' likes</b></div>'+(x.c?'<div class="pt"><b>'+p.u+'</b> '+x.c+'</div>':'')+'<div class="pt mu sm">'+x.d+'</div></div>';}
function homeV(){var a=ACC[S.acct];
var s='<div class="ih"><span class="wm">Instagram</span><span class="ir">'+I('heart',26)+I('dm',26)+'</span></div><div class="sr">'+(S.acct=='main'&&(State.variables.zStory|0)==2?'<div class="si" data-a="ms"><div class="ring">'+av(AV.main,62)+'</div><span>Your story</span></div>':'<div class="si"><div class="ring none">'+av(AV[S.acct],62)+'<i class="pl">+</i></div><span>Your story</span></div>')+'';
a.st.forEach(function(u){var sd=SD[u];s+='<div class="si"'+(sd?' data-a="sv" data-k="'+u+'"':(PK[u]?' data-a="pu" data-k="'+PK[u]+'"':''))+'><div class="ring'+(seen(u)?' seen':'')+'">'+ava(u,62)+'</div><span>'+u+'</span></div>';});
return s+'</div>'+(F('hs')?fpost('hs'):'')+fpost('zee')+fpost('nini');}
function expV(){var s='<div class="xs"><div class="sbar" data-a="srch">'+I('search',16,'#8e8e8e',2)+'<span>Search</span></div></div><div class="xg">',i;
if(S.acct=='main'){for(i=0;i<LAW.length;i++)s+='<div class="xt'+(i==1?' tall':'')+'" data-a="post" data-i="'+i+'" style="background:'+COL[i%6]+'"><span class="sc">⚖</span><b>'+LAW[i][0]+'</b></div>';}
else{for(i=0;i<15;i++)s+='<div class="xt" style="'+ph('#e6e6ea','#c9c9d1')+'"></div>';}
return s+'</div>';}
function reelsV(){return RL.html();}
var TH={"Zee": [["i", "story", "Zee shared a story with you", "s1966"], ["o", "t", "❤️"], ["i", "t", "😂"], ["i", "t", "🔥"]]};
function lastOf(u){var m=TH[u],l=m[m.length-1];return l[1]=='reel'?(l[0]=='o'?'You sent a reel':'Sent a reel'):(l[1]=='story'?'Mentioned you in their story':l[2]);}
function dmV(){var a=ACC[S.acct],s='<div class="dh"><span>'+I('back',24)+'</span><b>'+a.u+I('chev',16)+'</b><span class="gr">'+I('cmt',24)+'</span></div><div class="xs"><div class="sbar">'+I('search',16,'#8e8e8e',2)+'<span>Search</span></div></div><div class="dt"><b>Messages</b><span class="bl">Requests · 100+</span></div>';
 a.dm.forEach(function(u,i){var th=(S.acct=='main')?TH[u]:null;s+='<div class="dr"'+(th?' data-a="th" data-k="'+u+'"':(PK[u]?' data-a="pu" data-k="'+PK[u]+'"':''))+'>'+ava(u,56)+'<div><b>'+u+'</b><div class="mu">'+(th?lastOf(u):(i?'Active '+(i+1)+'h ago':'Sent a message · now'))+'</div></div></div>';});return s;}
function thV(){var u=S.th,m=TH[u]||[],s='<div class="ig-chat-head"><span data-a="thb">'+I('back',25,'#0095f6',2)+'</span><div class="ig-chat-person">'+ava(u,34)+'<div><b>'+u+'</b><small>Active now</small></div></div><div class="ig-chat-tools">'+I('dm',23,'#111')+I('cmt',23,'#111')+'</div></div><div class="ig-chat-profile">'+ava(u,76)+'<b>'+u+'</b><span>Instagram</span><small>You&#39;re not following each other on Instagram.</small><button type="button">View profile</button></div><div class="ig-chat-date">TODAY</div><div class="thm">';
 m.forEach(function(x){var c=(x[0]=='o')?'o':'i';if(x[1]=='reel')s+='<div class="thr '+c+'"><div class="thc reel"><div class="thp">▶</div><div class="thl">Shared a reel · '+x[2]+'</div></div></div>';else if(x[1]=='story')s+='<div class="thr '+c+'"><div class="thc story" style="background-image:url(\''+IM[x[3]]+'\')"><div class="thl">'+x[2]+'</div></div></div>';else s+='<div class="thr '+c+'"><div class="thb">'+x[2]+'</div></div>';});
 return s+'</div><div class="ig-chat-compose"><span class="ig-chat-camera">'+I('plus',20,'#fff',2)+'</span><div>Message…</div>'+I('heart',23,'#111')+'☺︎</div>';}
function meV(){var a=ACC[S.acct];
var s='<div class="dh"><b class="un" data-a="sheet">'+a.u+I('chev',16)+'</b><span class="gr" style="color:#000">'+I('plus',26)+'<span data-a="arch">'+I('menu',26)+'</span></span></div><div class="pro">'+av(AV[S.acct],86)+stats(a.po,a.fo,(S.acct=='main'&&!isNaN(+a.fg))?(+a.fg+(State.variables.igdL|0)):a.fg)+'</div><div class="bi"><b>'+a.n+'</b><div>'+a.bio+'</div></div><div class="bt"><span>Edit profile</span><span>Share profile</span></div><div class="hl">';
a.hl.forEach(function(h,i){if(typeof h=='string'){s+='<div class="hi"><div class="hc"></div><span>'+h+'</span></div>';}else{s+='<div class="hi" data-a="hl" data-i="'+i+'"><div class="hc" style="background-image:url(\''+IM[h.p[0]]+'\')"></div><span>'+h.n+'</span></div>';}});
return s+'</div>'+tabs2()+pgrid(S.acct=='main'?P.lou:P.priv);}
function pfV(){var p=P[S.pu],f=F(p.k);return '<div class="dh"><span data-a="back">'+I('back',26)+'</span><b>'+p.u+'</b><span class="gr" style="color:#000">'+I('dots',24)+'</span></div><div class="pro">'+av(AV[p.a],86)+stats(p.ps.length,p.fo,p.fg)+'</div><div class="bi"><b>'+p.n+'</b></div><div class="bt">'+'<span data-a="fol" data-k="'+p.k+'"'+(f?'':' class="fl"')+'>'+(f?'Following':(RQ(p.k)?'Requested':'Follow'))+'</span>'+'<span>Message</span></div>'+hlRow(p.k)+tabs2()+pgrid(p);}
function postV(){var p=LAW[S.i],id='law:'+S.i,b=2000+S.i*317;return '<div class="dh"><span data-a="back">'+I('back',26)+'</span><b>Posts</b><span class="gr"></span></div><div class="pr">'+av('',32,'L')+'<b>law.explained</b><span class="gr">'+I('dots',20)+'</span></div><div class="pi big" data-lk="'+id+'" style="background:'+COL[S.i%6]+'"><span class="sc">⚖</span><b>'+p[0]+'</b></div><div class="pa">'+hrt(id)+I('cmt',26)+I('dm',26)+'<span class="gr">'+I('bm',26)+'</span></div><div class="pt"><b>'+cnt(b,id)+' likes</b></div><div class="pt"><b>law.explained</b> '+p[1]+'</div><div class="pt mu sm">3 days ago</div>';}
function srchV(){return '<div class="dh"><span data-a="back">'+I('back',26)+'</span><div class="sbar grow">'+I('search',16,'#8e8e8e',2)+'<span>Search</span></div></div><div class="dt"><b>Recent</b></div><div class="mu cen">No recent searches.</div>';}
function tabbar(){var t=[['home','home'],['explore','search'],['reels','reels'],['dm','dm'],['me','']],s='<div class="tbb">';
t.forEach(function(x){var on=S.tab==x[0]&&!S.view;s+='<span data-a="tab" data-k="'+x[0]+'">'+(x[0]=='me'?'<div class="'+(on?'ring2':'')+'">'+av(AV[S.acct],26)+'</div>':I(x[1],27,'#000',on?2.6:1.8,(on&&x[0]=='home')?'#000':'none'))+'</span>';});
return s+'</div>';}
function sheet(){var s='<div class="sh-bg" data-a="close"></div><div class="sh"><div class="gp"></div><b class="sh-t">Switch accounts</b>';
['main','priv'].forEach(function(k){var a=ACC[k];s+='<div class="shr" data-a="sw" data-k="'+k+'">'+av(AV[k],52)+'<div><b>'+a.u+'</b><div class="mu">'+a.n+'</div></div><i class="rd'+(S.acct==k?' on':'')+'"></i></div>';});
return s+'<div class="shr"><span class="pl2">+</span><b class="bl">Add Instagram account</b></div></div>';}
function frames(k){return P[k].ps.slice(0,3).map(function(x){return x.k;});}
var P_SD_INIT=0;
var SD={Zee:frames('zee'),NiniH:frames('nini'),Lipayn:frames('li'),lawsociety:[['txt','Free legal clinic this Saturday, Room 204.','#2f7d5a'],['txt','Pro bono sign-ups close Friday.','#14213d']],'moot.court':[['txt','Moot Court semifinals this Friday in the main hall.','#7a1f2b'],['txt','Come support the team.','#1d4e89']]};
function seen(u){return (State.variables.igsL||{})[u];}
function mark(u){var v=State.variables;(v.igsL=v.igsL||{})[u]=1;}
function FS(k){var f=State.variables.igfL||{};return (k in f)?f[k]:-1;}
function F(k){var s=FS(k);if(s===1)return true;if(s===0||s===2)return false;return !(k=='hs'||(S.acct=='priv'&&k=='li'));}
function RQ(k){return FS(k)===2;}
var HLO={hs:[{n:'Football ⚽',p:["h1910", "h1909", "h1908"],d:["Sep 14, 2026", "Sep 20, 2026", "Oct 2, 2026"]},{n:'Union 🏛️',p:["h1900"],d:["Oct 8, 2026"]},{n:'Travel ✈️',p:["h1905", "h1906", "h1901"],d:["Aug 2, 2026", "Aug 4, 2026", "Aug 6, 2026"]}]};
function curH(){var o=S.hv.o;if(S.hv.k==-2)return {p:SD[S.hv.u]};if(S.hv.k==-3){var A=arch();return {p:A.map(function(x){return x.k;}),d:A.map(function(x){return x.d;})};}if(o)return HLO[o][S.hv.k];return S.hv.k<0?STORY:ACC[S.acct].hl[S.hv.k];}
function arch(){var A=[];ACC.main.hl.forEach(function(h){if(typeof h=='string')return;h.p.forEach(function(k,i){A.push({k:k,d:h.d[i]});});});A.push({k:'s1966',d:'Nov 5, 2026'});A.sort(function(a,b){return new Date(b.d)-new Date(a.d);});return A;}
function hlRow(k){var Lh=HLO[k];if(!Lh)return '';var s='<div class="hl">';Lh.forEach(function(h,i){s+='<div class="hi" data-a="hlo" data-i="'+i+'" data-k="'+k+'"><div class="hc" style="background-image:url(\''+IM[h.p[0]]+'\')"></div><span>'+h.n+'</span></div>';});return s+'</div>';}
function archV(){var A=arch(),s='<div class="dh"><span data-a="back">'+I('back',26)+'</span><b>Archive</b><span></span></div><div class="dt"><b>Stories archive</b></div><div class="xg">';A.forEach(function(x,i){s+='<div class="xt" data-a="av" data-i="'+i+'" style="background-image:url(\''+IM[x.k]+'\')"><div class="ard">'+x.d+'</div></div>';});return s+'</div>';}
function hvV(){var u=S.hv.u,k2=(S.hv.k==-2),ow=S.hv.o,h=curH(),n=h.p.length,it=h.p[S.hv.j],tx=(typeof it!='string'),dl=k2?((['2h','5h','9h'][S.hv.j]||'1d')+' ago'):(h.d?h.d[S.hv.j]:(S.hv.k==-1?'Nov 5, 2026':'')),who=k2?ava(u,32)+'<b>'+u+'</b>':(ow?av(AV[P[ow].a],32)+'<b>'+P[ow].u+'</b>':av(AV[S.acct],32)+'<b>'+ACC[S.acct].u+'</b>'),bgs=tx?'background:'+it[2]:'background-image:url(\''+IM[it]+'\')',s='<div class="hv"><div class="hvi" style="'+bgs+'">'+(tx?'<div class="hvt">'+it[1]+'</div>':'')+'</div><div class="hvg"></div><div class="hpb">',i;
for(i=0;i<n;i++)s+='<i><b class="'+(i<S.hv.j?'f':(i==S.hv.j?'a':''))+'"></b></i>';
return s+'</div><div class="hvh">'+who+'<span class="hvd">'+dl+'</span><span class="gr">'+I('dots',22,'#fff')+'<span data-a="hx">'+I('x',24,'#fff',2)+'</span></span></div>'+(S.hv.k==-1?'<div class="hcap">try new something. <span class="hmen">@zayn</span></div>':'')+'<div class="hvl" data-a="hp"></div><div class="hvr" data-a="hn"></div><div class="hvf">'+(S.hv.k==-1?'<div class="hvm" data-a="vw">👁 Seen by <b>hstyles</b> and 2,431 others</div>':'<div class="hvm">Send message</div>')+I('heart',28,'#fff')+I('dm',28,'#fff')+'</div></div>';}
function pgrid(p){var s='<div class="pg">';p.ps.forEach(function(x,i){s+='<div class="pc" data-a="hsp" data-k="'+p.k+'" data-i="'+i+'" style="background-image:url(\''+IM[x.k]+'\')"></div>';});return s+'</div>';}
function hpostV(){var p=P[S.pu],x=p.ps[S.i],id=p.k+':'+S.i;return '<div class="dh"><span data-a="hsb">'+I('back',26)+'</span><b>Posts</b><span class="gr"></span></div><div class="pr">'+av(AV[p.a],32)+'<b>'+p.u+'</b><span class="gr">'+I('dots',20)+'</span></div><div class="pi img" data-lk="'+id+'" style="background-image:url(\''+IM[x.k]+'\')"></div><div class="pa">'+hrt(id)+(p.cm?I('cmt',26):'')+I('dm',26)+'<span class="gr">'+I('bm',26)+'</span></div><div class="pt"><b>'+cnt(x.l,id)+' likes</b></div>'+(x.c?'<div class="pt"><b>'+p.u+'</b> '+x.c+'</div>':'')+(p.cm?'<div class="pt mu">View all '+x.m+' comments</div>':'<div class="pt mu">Comments on this post have been limited.</div>')+'<div class="pt mu sm">'+x.d+'</div>';}
function adv(){var h=curH();S.hv.j++;if(S.hv.j>=h.p.length){if(S.hv.k==-2)mark(S.hv.u);S.hv=null;}render();}
function stpV(){return '<div class="sh-bg" style="z-index:8"></div><div class="lg" style="z-index:9;top:70px"><b>Share to your story?</b><div class="stp" style="background-image:url(\''+IM.s1966+'\')"><span>try new something. <u>@zayn</u></span></div><div class="lgb" data-a="sshare">Share</div><div class="lgb gy2" data-a="sno">Don’t share</div></div>';}
function rsV(){return '<div class="wres" data-a="rx"><div class="wrc g"><b>+5</b>Your relationship with Zayn gained +5 points.</div></div>';}
function vwV(){var r=[['hstyles','H Styles','hs'],['Zee','Z','zee'],['NiniH','NiniH','nini'],['Lipayn','Li','li'],['lawsociety','Law Society',''],['moot.court','Moot Court','']];return '<div class="sh-bg" data-a="vx" style="z-index:8"></div><div class="sh" style="z-index:9;max-height:520px;overflow:auto"><div class="gp"></div><b class="sh-t">Viewers · 2,431</b>'+r.map(function(x){return '<div class="shr">'+av(x[2]?AV[x[2]]:'',44,x[0])+'<div><b>'+x[0]+'</b><div class="mu">'+x[1]+'</div></div></div>';}).join('')+'</div>';}
function render(kp){var v,y=kp?($('.igc').scrollTop()||0):0;
if(S.view=='pf')v=pfV();else if(S.view=='post')v=postV();else if(S.view=='srch')v=srchV();else if(S.view=='th')v=thV();else if(S.view=='arch')v=archV();else if(S.view=='hpost')v=hpostV(); else v={home:homeV,explore:expV,reels:reelsV,dm:dmV,me:meV}[S.tab]();
$('#igroot').html('<div class="igc">'+v+'</div>'+tabbar()+(S.sheet?sheet():'')+(S.hv?hvV():'')+(S.login?loginV():'')+(S.pr?stpV():'')+(S.rs?rsV():'')+(S.vw?vwV():''));
$('.igc').scrollTop(y);if(window.RL)RL.init();$('.screen').toggleClass('light',!S.hv);clearTimeout(T);if(S.hv&&!S.vw){T=setTimeout(function(){adv();},5000);}}
function mount(){clearTimeout(T);S.view=null;S.sheet=false;S.hv=null;S.vw=false;S.rs=0;S.pr=((State.variables.zStory|0)==1);if(S.pr){S.tab='home';S.acct='main';}render();
$(document).off('click.ig').on('click.ig','#igroot [data-a]',function(){var t=$(this),d=t.data('a'),k=t.data('k'),kp=0;
if(d=='tab'){S.tab=k;S.view=null;}
else if(d=='srch'){S.pu='hs';S.view=S.acct=='main'?'pf':'srch';}
else if(d=='back'){S.view=null;}
else if(d=='post'){S.view='post';S.i=t.data('i');}
else if(d=='sheet'){S.sheet=true;}
else if(d=='close'){S.sheet=false;}
else if(d=='sw'){S.sheet=false;if(k=='priv'&&!S.auth){S.login=true;S.err=0;}else{S.acct=k;S.tab='me';S.view=null;}}
else if(d=='login'){if(String($('#igpw').val()).replace(/\s+/g,'').toLowerCase()==PW){S.auth=true;S.login=false;S.err=0;S.acct='priv';S.tab='me';S.view=null;}else{S.err=1;}}
else if(d=='lc'){S.login=false;S.err=0;}
else if(d=='lk'){LK[k]=!LK[k];kp=1;}
else if(d=='hl'){S.hv={k:t.data('i'),j:0};}
else if(d=='hn'){adv();return;}
else if(d=='hp'){S.hv.j=Math.max(0,S.hv.j-1);}
else if(d=='hx'){if(S.hv&&S.hv.k==-2)mark(S.hv.u);S.hv=null;S.vw=false;}
else if(d=='sshare'){State.variables.zStory=2;State.variables.zayn=(State.variables.zayn|0)+5;S.pr=false;S.rs=1;}
else if(d=='sno'){State.variables.zStory=3;S.pr=false;}

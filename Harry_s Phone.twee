.hcm{flex:1;overflow-y:auto;padding:12px 12px 40px;display:flex;flex-direction:column;gap:6px;scrollbar-width:none}
.hcb{max-width:76%;padding:8px 13px;border-radius:19px;line-height:1.3;word-wrap:break-word}
.hco{align-self:flex-end;background:#0b84fe;color:#fff}
.hci{align-self:flex-start;background:#e9e9eb;color:#000}
.hct{letter-spacing:2px;color:#8e8e93}

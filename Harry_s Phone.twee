/* ===== Hikaye sayfalari (telefon CSS'inden ayri) ===== */
body.story,body[data-passage^="C1-"],body[data-passage^="C2-"]{display:block !important;overflow:auto !important;min-height:100vh;background:#0e0e12 !important}
body.story #passages,body[data-passage^="C1-"] #passages,body[data-passage^="C2-"] #passages{display:block !important;max-width:40em !important;margin:0 auto !important;padding:1.2em 1.1em 5em !important;min-height:100vh;background:none !important;font-size:1.05em;line-height:1.7;text-align:left}
.sep{text-align:center;opacity:.7;margin:1.5em 0}
.choice{margin-top:1.5em}
.choice a{display:block;margin:.6em 0;padding:.7em 1em;border:1px solid #0b84fe;border-radius:.6em;text-align:center;position:relative;z-index:5}
.phone-open a,.phone-open button{display:inline-block;margin-top:1.2em;padding:.55em 1.2em;border-radius:2em;border:1px solid #0b84fe;color:#fff;background:#0b84fe;font-size:1em;cursor:pointer;text-decoration:none}
.backstory{position:fixed;left:50%;transform:translateX(-50%);bottom:10px;z-index:99999;background:#0b84fe;color:#fff;padding:.55em 1.2em;border-radius:2em;font:600 14px -apple-system,Arial,sans-serif;cursor:pointer;box-shadow:0 4px 14px rgba(0,0,0,.5)}

/* ===== Harry'nin Zayn yazismasi ===== */
#hcroot{position:absolute;inset:54px 0 0 0;background:#fff;color:#000;display:flex;flex-direction:column;font-size:16px}
.hch{display:flex;align-items:center;gap:10px;padding:6px 14px 10px;border-bottom:1px solid #e5e5ea}
